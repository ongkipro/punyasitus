---
/**
 * Native HTTP 503 Maintenance View Component (DESIGN.md §9, PLAN §3.3, §17.1; REQ-060).
 *
 * Hard invariants:
 * - Zero tracking, zero third-party requests, zero client JavaScript required.
 * - Zero tenant data and zero platform links/branding leak.
 * - Accessible semantic `<main>` landmark, clear Bahasa Indonesia non-technical copy,
 *   high contrast, responsive at 360px and 1440px with zero horizontal overflow.
 */
export interface Props {
  heading?: string;
  body?: string;
  badge?: string;
}

const {
  heading = "Situs dalam perbaikan",
  body = "Situs ini sementara tidak dapat diakses. Silakan kembali lagi nanti.",
  badge = "Pemeliharaan Sementara · HTTP 503",
} = Astro.props;
---

<div class="ps-maintenance-viewport">
  <main class="ps-maintenance-card" data-maintenance-page="503" aria-labelledby="maintenance-heading">
    <div class="ps-maintenance-icon" aria-hidden="true">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
      </svg>
    </div>
    <div>
      <span class="ps-maintenance-badge">{badge}</span>
    </div>
    <h1 id="maintenance-heading" class="ps-maintenance-heading">{heading}</h1>
    <p class="ps-maintenance-body">{body}</p>
    <p class="ps-maintenance-hint">
      Tidak diperlukan tindakan dari pengunjung. Coba muat ulang halaman ini beberapa saat lagi.
    </p>
  </main>
</div>

<style>
  .ps-maintenance-viewport {
    display: flex;
    min-height: 100dvh;
    width: 100%;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1rem;
    background-color: #f8fafc;
    color: #0f172a;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      "Helvetica Neue",
      Arial,
      sans-serif;
    font-size: 16px;
    line-height: 1.6;
    box-sizing: border-box;
  }

  .ps-maintenance-card {
    width: 100%;
    max-width: 32rem;
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    padding: 2rem 1.5rem;
    text-align: center;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
    box-sizing: border-box;
  }

  .ps-maintenance-icon {
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 1.25rem;
    border-radius: 9999px;
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    color: #92400e;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ps-maintenance-badge {
    display: inline-block;
    margin-bottom: 0.875rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background-color: #fef3c7;
    border: 1px solid #fde68a;
    color: #92400e;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .ps-maintenance-heading {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 700;
    color: #0f172a;
  }

  .ps-maintenance-body {
    margin: 0;
    font-size: 0.9375rem;
    color: #475569;
  }

  .ps-maintenance-hint {
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid #e2e8f0;
    font-size: 0.8125rem;
    color: #475569;
  }

  @media (min-width: 640px) {
    .ps-maintenance-card {
      padding: 2.5rem 2.25rem;
    }

    .ps-maintenance-heading {
      font-size: 1.75rem;
    }
  }
</style>
