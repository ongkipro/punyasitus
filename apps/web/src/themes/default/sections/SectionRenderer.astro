---
import "./sections.css";
import type { PublicBranchViewInput } from "@punyasitus/core/branches/index";
import type { PublishedFormDefinition } from "@punyasitus/core/forms/index";
import type {
  BlogLatestSectionConfig,
  ContactLocationSectionConfig,
  CtaBannerSectionConfig,
  FaqSectionConfig,
  FeaturesSectionConfig,
  GallerySectionConfig,
  HeroSectionConfig,
  HeroVariant,
  OfferingsGridSectionConfig,
  RichTextSectionConfig,
  TestimonialsSectionConfig,
} from "@punyasitus/core/theme/index";
import {
  safeAssemblePageSections,
  type PageAssemblyMode,
  type SectionOfferingItem,
} from "../../../core/section-registry.ts";
import SectionBlogLatest from "./SectionBlogLatest.astro";
import SectionBranches from "./SectionBranches.astro";
import SectionContactForm from "./SectionContactForm.astro";
import SectionContactLocation from "./SectionContactLocation.astro";
import SectionCtaBanner from "./SectionCtaBanner.astro";
import SectionCustomForm from "./SectionCustomForm.astro";
import SectionFaq from "./SectionFaq.astro";
import SectionFeatures from "./SectionFeatures.astro";
import SectionGallery from "./SectionGallery.astro";
import SectionHero from "./SectionHero.astro";
import SectionOfferingsGrid from "./SectionOfferingsGrid.astro";
import SectionRichText from "./SectionRichText.astro";
import SectionTestimonials from "./SectionTestimonials.astro";

/**
 * Dynamic Page Section Assembler (`apps/web/src/themes/default/sections/SectionRenderer.astro`).
 *
 * Maps validated page sections through the closed unified registry in exact order,
 * skipping disabled sections, applying Permenkes health-category guardrails,
 * supporting both `/` and `/{pageSlug}` across all 6 platform themes, and failing
 * safely on invalid section entries without crashing SSR.
 */

export interface Props {
  readonly sections: unknown;
  readonly themeId: string;
  readonly routePath?: string;
  readonly pageSlug?: string | null;
  readonly isHomepage?: boolean;
  readonly mode?: PageAssemblyMode;
  readonly businessCategory?: string | null;
  readonly heroVariant?: HeroVariant;
  readonly primaryOrigin?: string;
  readonly fallbackOfferings?: readonly SectionOfferingItem[];
  readonly fallbackPosts?: BlogLatestSectionConfig["posts"];
  readonly fallbackBranches?: readonly PublicBranchViewInput[];
  readonly fallbackForms?: Readonly<Record<string, PublishedFormDefinition>>;
  readonly turnstileSiteKey?: string;
  readonly showContactForm?: boolean;
  readonly googleMapsReviewUrl?: string | null;
  readonly businessName?: string | null;
  readonly fallbackBusiness?: {
    readonly address?: string | null;
    readonly city?: string | null;
    readonly province?: string | null;
    readonly postalCode?: string | null;
    readonly weekdayHours?: string | null;
    readonly holidayHours?: string | null;
    readonly phone?: string | null;
    readonly whatsappE164?: string | null;
    readonly email?: string | null;
    readonly mapsUrl?: string | null;
  };
}

const {
  sections,
  themeId,
  routePath,
  pageSlug = null,
  isHomepage,
  mode = "published",
  businessCategory = null,
  heroVariant,
  primaryOrigin = "https://situsku.click",
  fallbackOfferings = [],
  fallbackPosts = [],
  fallbackBranches = [],
  fallbackForms = {},
  turnstileSiteKey,
  showContactForm = false,
  googleMapsReviewUrl = null,
  businessName = null,
  fallbackBusiness,
} = Astro.props;

const contactBranchOptions = fallbackBranches
  .map((branch, idx) => {
    const parsedId =
      typeof branch.id === "number" && Number.isFinite(branch.id)
        ? branch.id
        : typeof branch.id === "string" && /^\d+$/.test(branch.id)
          ? Number(branch.id)
          : idx + 1;
    return {
      id: parsedId,
      name: branch.name,
      address: branch.address ?? null,
      whatsappE164: branch.whatsappE164 ?? null,
    };
  });

const result = safeAssemblePageSections({
  sections,
  themeId,
  routePath,
  pageSlug,
  isHomepage,
  mode,
  businessCategory,
});

const assembled = result.ok ? result.assembled : null;
const assemblyErrorCode = result.ok ? null : result.error.code;
const resolvedHeroVariant: HeroVariant =
  heroVariant ?? assembled?.themeProfile.heroVariant ?? "split";
---

{assembled ? (
  <div
    class="ps-page-sections"
    data-testid="page-sections-root"
    data-route-kind={assembled.routeKind}
    data-route-path={assembled.routePath}
    data-theme-id={assembled.themeId}
    data-assembly-mode={assembled.mode}
    data-rendered-count={String(assembled.renderableSections.length)}
    data-permenkes-warnings={String(assembled.warnings.length)}
  >
    {assembled.renderableSections.map((item) => {
      const { section, componentKey, surfaceTone, isFirstSection } = item;
      switch (componentKey) {
        case "SectionHero":
          return (
            <SectionHero
              id={section.id}
              config={section.config as HeroSectionConfig}
              heroVariant={resolvedHeroVariant}
              isPreview={assembled.isPreview}
              isFirstSection={isFirstSection}
            />
          );
        case "SectionFeatures":
          return (
            <SectionFeatures
              id={section.id}
              sectionType={section.type}
              config={section.config as FeaturesSectionConfig}
              surfaceTone={surfaceTone}
              isPreview={assembled.isPreview}
              isFirstSection={isFirstSection}
            />
          );
        case "SectionOfferingsGrid":
          return (
            <SectionOfferingsGrid
              id={section.id}
              sectionType={section.type}
              config={section.config as OfferingsGridSectionConfig}
              fallbackOfferings={fallbackOfferings}
              fallbackWhatsappPhone={fallbackBusiness?.whatsappE164 ?? null}
              primaryOrigin={primaryOrigin}
              surfaceTone={surfaceTone}
              isPreview={assembled.isPreview}
              isFirstSection={isFirstSection}
            />
          );
        case "SectionRichText":
          return (
            <SectionRichText
              id={section.id}
              sectionType={section.type}
              config={section.config as RichTextSectionConfig}
              surfaceTone={surfaceTone}
              isPreview={assembled.isPreview}
              isFirstSection={isFirstSection}
            />
          );
        case "SectionGallery":
          return (
            <SectionGallery
              id={section.id}
              config={section.config as GallerySectionConfig}
              surfaceTone={surfaceTone}
              isPreview={assembled.isPreview}
              isFirstSection={isFirstSection}
            />
          );
        case "SectionTestimonials":
          return (
            <SectionTestimonials
              id={section.id}
              config={section.config as TestimonialsSectionConfig}
              isHealthCategory={assembled.isHealthCategory}
              surfaceTone={surfaceTone}
              isFirstSection={isFirstSection}
            />
          );
        case "SectionFaq":
          return (
            <SectionFaq
              id={section.id}
              config={section.config as FaqSectionConfig}
              surfaceTone={surfaceTone}
              isFirstSection={isFirstSection}
            />
          );
        case "SectionBlogLatest":
          return (
            <SectionBlogLatest
              id={section.id}
              sectionType={section.type}
              config={section.config as BlogLatestSectionConfig}
              fallbackPosts={fallbackPosts}
              surfaceTone={surfaceTone}
              isPreview={assembled.isPreview}
              isFirstSection={isFirstSection}
            />
          );
        case "SectionCtaBanner": {
          const ctaConfig = section.config as CtaBannerSectionConfig;
          if (section.type === "custom_form") {
            const formSlug = ctaConfig.formSlug?.trim() || null;
            const matchedForm = formSlug ? fallbackForms[formSlug] ?? null : null;
            if (matchedForm) {
              return (
                <SectionCustomForm
                  id={section.id}
                  form={matchedForm}
                  eyebrow={ctaConfig.eyebrow ?? undefined}
                  businessName={businessName ?? undefined}
                  sourcePath={assembled.routePath}
                  returnTo={assembled.routePath}
                  turnstileSiteKey={turnstileSiteKey}
                  isHealthCategory={assembled.isHealthCategory}
                  surfaceTone={surfaceTone}
                  isPreview={assembled.isPreview}
                  isFirstSection={isFirstSection}
                />
              );
            }
            if (formSlug === "contact") {
              return (
                <SectionContactForm
                  id={section.id}
                  eyebrow={ctaConfig.eyebrow ?? undefined}
                  heading={ctaConfig.heading}
                  subheading={ctaConfig.subheading ?? undefined}
                  submitLabel={ctaConfig.primaryCta.label}
                  businessName={businessName ?? undefined}
                  sourcePath={assembled.routePath}
                  returnTo={assembled.routePath}
                  turnstileSiteKey={turnstileSiteKey}
                  branches={contactBranchOptions}
                  whatsappPhone={fallbackBusiness?.whatsappE164 ?? null}
                  primaryOrigin={primaryOrigin}
                  googleMapsReviewUrl={googleMapsReviewUrl}
                  surfaceTone={surfaceTone}
                  isPreview={assembled.isPreview}
                  isFirstSection={isFirstSection}
                />
              );
            }
          }
          return (
            <SectionCtaBanner
              id={section.id}
              sectionType={section.type}
              config={ctaConfig}
              surfaceTone={surfaceTone}
              isPreview={assembled.isPreview}
              isFirstSection={isFirstSection}
            />
          );
        }
        case "SectionContactLocation": {
          const contactConfig = section.config as ContactLocationSectionConfig;
          if (section.type === "branches") {
            const resolvedBranches: readonly PublicBranchViewInput[] =
              fallbackBranches.length > 0
                ? fallbackBranches
                : contactConfig.branches.map((branch, idx) => ({
                    id: idx + 1,
                    name: branch.name,
                    address: branch.address,
                    whatsappE164: branch.whatsappPhone ?? null,
                    mapsUrl: branch.mapsUrl ?? null,
                    weekdayHours: branch.weekdayHours ?? null,
                    holidayHours: branch.holidayHours ?? null,
                    active: true,
                    sortOrder: idx,
                  }));
            return (
              <SectionBranches
                id={section.id}
                eyebrow={contactConfig.eyebrow}
                heading={contactConfig.heading}
                subheading={contactConfig.subheading}
                businessName={businessName}
                headOffice={
                  fallbackBusiness
                    ? {
                        name: businessName,
                        address: contactConfig.address ?? fallbackBusiness.address,
                        city: fallbackBusiness.city,
                        province: fallbackBusiness.province,
                        postalCode: fallbackBusiness.postalCode,
                        phone: contactConfig.phone ?? fallbackBusiness.phone,
                        whatsappE164: contactConfig.whatsappPhone ?? fallbackBusiness.whatsappE164,
                        mapsUrl: contactConfig.mapsUrl ?? fallbackBusiness.mapsUrl,
                        weekdayHours: contactConfig.weekdayHours ?? fallbackBusiness.weekdayHours,
                        holidayHours: contactConfig.holidayHours ?? fallbackBusiness.holidayHours,
                      }
                    : null
                }
                branches={resolvedBranches}
                surfaceTone={surfaceTone}
                isPreview={assembled.isPreview}
                isFirstSection={isFirstSection}
                mapsLabel={contactConfig.mapsLabel}
              />
            );
          }
          return (
            <>
              <SectionContactLocation
                id={section.id}
                sectionType={section.type}
                config={contactConfig}
                fallbackBusiness={fallbackBusiness}
                surfaceTone={surfaceTone}
                isPreview={assembled.isPreview}
                isFirstSection={isFirstSection}
              />
              {showContactForm && (
                <SectionContactForm
                  id={`${section.id}-form`}
                  businessName={businessName ?? undefined}
                  sourcePath={assembled.routePath}
                  returnTo={assembled.routePath}
                  turnstileSiteKey={turnstileSiteKey}
                  branches={contactBranchOptions}
                  whatsappPhone={contactConfig.whatsappPhone ?? fallbackBusiness?.whatsappE164 ?? null}
                  primaryOrigin={primaryOrigin}
                  googleMapsReviewUrl={googleMapsReviewUrl}
                  surfaceTone={surfaceTone === "surface" ? "muted" : "surface"}
                  isPreview={assembled.isPreview}
                />
              )}
            </>
          );
        }
      }
    })}
  </div>
) : (
  <section
    class="ps-section"
    role="status"
    data-testid="section-renderer-error"
    data-error-code={assemblyErrorCode ?? "INVALID_SECTION_CONFIG"}
  >
    <div class="ps-container">
      <p class="ps-empty-state">
        Konfigurasi susunan halaman tidak dapat ditampilkan saat ini.
      </p>
    </div>
  </section>
)}
