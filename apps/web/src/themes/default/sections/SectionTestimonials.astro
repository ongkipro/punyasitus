---
import { buildSafeGoogleMapsReviewLink } from "@punyasitus/core/settings/google-maps-review";
import {
  PERMENKES_TESTIMONIALS_WARNING_MESSAGE,
  type TestimonialsSectionConfig,
} from "@punyasitus/core/theme/index";

export interface Props {
  readonly id: string;
  readonly config: TestimonialsSectionConfig;
  readonly isHealthCategory?: boolean;
  readonly surfaceTone?: "surface" | "muted";
  readonly isFirstSection?: boolean;
  readonly googleMapsReviewUrl?: string | null;
  readonly googleMapsReviewLabel?: string;
  readonly isPreview?: boolean;
}

const {
  id,
  config,
  isHealthCategory = false,
  surfaceTone = "surface",
  isFirstSection = false,
  googleMapsReviewUrl = null,
  googleMapsReviewLabel,
  isPreview = false,
} = Astro.props;

const headingId = `section-${id}-heading`;
const reviewLink = buildSafeGoogleMapsReviewLink(googleMapsReviewUrl, {
  label: googleMapsReviewLabel,
});
---

<section
  id={id}
  class:list={["ps-section", surfaceTone === "muted" && "ps-section--muted"]}
  data-section-id={id}
  data-section-type="testimonials"
  data-health-category={isHealthCategory ? "true" : "false"}
  data-testid={`section-${id}`}
  aria-labelledby={headingId}
>
  <div class="ps-container">
    <header class="ps-section-header">
      {config.eyebrow && <p class="ps-eyebrow">{config.eyebrow}</p>}
      {isFirstSection ? (
        <h1 id={headingId} class="ps-section-title">
          {config.heading}
        </h1>
      ) : (
        <h2 id={headingId} class="ps-section-title">
          {config.heading}
        </h2>
      )}
      {config.subheading && <p class="ps-section-subtitle">{config.subheading}</p>}
    </header>

    {isHealthCategory && (
      <p
        class="ps-compliance-notice"
        role="note"
        data-testid={`section-${id}-permenkes-notice`}
      >
        {config.disclaimerText ?? PERMENKES_TESTIMONIALS_WARNING_MESSAGE}
      </p>
    )}

    {config.items.length > 0 ? (
      <div class="ps-card-grid ps-card-grid--3">
        {config.items.map((item) => (
          <figure class="ps-card ps-testimonial-card" style="margin: 0;">
            <blockquote class="ps-testimonial-quote">“{item.quote}”</blockquote>
            <figcaption class="ps-testimonial-author">
              <span class="ps-testimonial-name">{item.authorName}</span>
              {(item.authorRole || item.contextLabel) && (
                <span class="ps-testimonial-role">
                  {[item.authorRole, item.contextLabel].filter(Boolean).join(" · ")}
                </span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <p class="ps-empty-state">Belum ada testimoni yang ditampilkan.</p>
    )}

    {reviewLink && (
      <div class="ps-review-link-row" data-testid={`section-${id}-google-review`}>
        <a
          href={isPreview ? undefined : reviewLink.href}
          target={isPreview ? undefined : reviewLink.target}
          rel={isPreview ? undefined : reviewLink.rel}
          aria-disabled={isPreview ? "true" : undefined}
          class:list={[
            "ps-btn ps-btn--secondary ps-review-link-cta",
            isPreview && "ps-btn--inert",
          ]}
          data-testid="google-maps-review-link"
          data-review-link-kind={reviewLink.kind}
        >
          <span>{reviewLink.label}</span>
          <span aria-hidden="true">&#8599;</span>
        </a>
        <p class="ps-review-link-note">
          Tautan eksternal ke profil Google Maps resmi kami.
        </p>
      </div>
    )}
  </div>
</section>

<style>
  .ps-review-link-row {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .ps-review-link-cta {
    min-height: 44px;
    max-width: 100%;
    box-sizing: border-box;
  }

  .ps-review-link-note {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ps-ink-muted);
  }
</style>
