---
import {
  MAX_YOUTUBE_VIDEOS_PER_GALLERY,
  sanitizeYouTubePosterUrl,
} from "@punyasitus/core/media/youtube";
import type { GallerySectionConfig } from "@punyasitus/core/theme/index";
import YouTubeFacade from "../components/YouTubeFacade.astro";

/**
 * Semantic Gallery Section (`apps/web/src/themes/default/sections/SectionGallery.astro`).
 *
 * Renders responsive image cards with reserved aspect ratio and privacy-preserving
 * click-to-load `<YouTubeFacade>` video cards (REQ-089, TASK-089):
 * - Zero `<iframe>` in initial SSR HTML
 * - Zero external `ytimg.com` / YouTube network requests before explicit visitor click
 * - Enforces at most 3 YouTube video items per gallery section
 */

export interface Props {
  readonly id: string;
  readonly config: GallerySectionConfig;
  readonly surfaceTone?: "surface" | "muted";
  readonly isPreview?: boolean;
  readonly isFirstSection?: boolean;
}

const {
  id,
  config,
  surfaceTone = "surface",
  isPreview = false,
  isFirstSection = false,
} = Astro.props;

const headingId = `section-${id}-heading`;
const gridClass = `ps-gallery-grid ps-gallery-grid--${config.columns}`;

let youtubeCount = 0;
const renderableItems = config.items.filter((item) => {
  if (item.kind !== "youtube") return true;
  youtubeCount += 1;
  return youtubeCount <= MAX_YOUTUBE_VIDEOS_PER_GALLERY;
});

let youtubeRenderIndex = 0;
---

<section
  id={id}
  class:list={["ps-section", surfaceTone === "muted" && "ps-section--muted"]}
  data-section-id={id}
  data-section-type="gallery"
  data-testid={`section-${id}`}
  aria-labelledby={headingId}
>
  <div class="ps-container">
    <header class="ps-section-header">
      {config.eyebrow && <p class="ps-eyebrow">{config.eyebrow}</p>}
      {isFirstSection ? (
        <h1 id={headingId} class="ps-section-title">
          {config.heading}
        </h1>
      ) : (
        <h2 id={headingId} class="ps-section-title">
          {config.heading}
        </h2>
      )}
      {config.subheading && <p class="ps-section-subtitle">{config.subheading}</p>}
    </header>

    {renderableItems.length > 0 ? (
      <div class={gridClass}>
        {renderableItems.map((item) => {
          if (item.kind === "youtube") {
            const currentYtIdx = youtubeRenderIndex;
            youtubeRenderIndex += 1;
            const safePoster = sanitizeYouTubePosterUrl(item.posterUrl);
            return (
              <figure
                class="ps-gallery-item"
                data-gallery-item-kind="youtube"
                data-youtube-video-id={item.videoId}
              >
                <YouTubeFacade
                  videoId={item.videoId}
                  title={item.title}
                  posterUrl={safePoster}
                  mode={isPreview ? "preview" : "published"}
                  context="gallery"
                  testId={`section-${id}-youtube-${currentYtIdx}`}
                />
                {item.caption && <figcaption class="ps-gallery-caption">{item.caption}</figcaption>}
              </figure>
            );
          }

          return (
            <figure class="ps-gallery-item" data-gallery-item-kind="image">
              <div class="ps-gallery-frame">
                <img
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              {item.caption && <figcaption class="ps-gallery-caption">{item.caption}</figcaption>}
            </figure>
          );
        })}
      </div>
    ) : (
      <p class="ps-empty-state">Belum ada dokumentasi galeri yang ditambahkan.</p>
    )}
  </div>
</section>
