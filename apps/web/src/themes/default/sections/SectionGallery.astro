---
import type { GallerySectionConfig } from "@punyasitus/core/theme/index";

/**
 * Semantic Gallery Section (`apps/web/src/themes/default/sections/SectionGallery.astro`).
 *
 * Renders responsive image cards with reserved aspect ratio and privacy-safe
 * zero-network-request YouTube video placeholders ready for downstream `TASK-089`
 * click-to-load `YouTubeFacade.astro` integration (zero raw `<iframe>` embeds).
 */

export interface Props {
  readonly id: string;
  readonly config: GallerySectionConfig;
  readonly surfaceTone?: "surface" | "muted";
  readonly isPreview?: boolean;
  readonly isFirstSection?: boolean;
}

const {
  id,
  config,
  surfaceTone = "surface",
  isPreview = false,
  isFirstSection = false,
} = Astro.props;

const headingId = `section-${id}-heading`;
const gridClass = `ps-gallery-grid ps-gallery-grid--${config.columns}`;
---

<section
  id={id}
  class:list={["ps-section", surfaceTone === "muted" && "ps-section--muted"]}
  data-section-id={id}
  data-section-type="gallery"
  data-testid={`section-${id}`}
  aria-labelledby={headingId}
>
  <div class="ps-container">
    <header class="ps-section-header">
      {config.eyebrow && <p class="ps-eyebrow">{config.eyebrow}</p>}
      {isFirstSection ? (
        <h1 id={headingId} class="ps-section-title">
          {config.heading}
        </h1>
      ) : (
        <h2 id={headingId} class="ps-section-title">
          {config.heading}
        </h2>
      )}
      {config.subheading && <p class="ps-section-subtitle">{config.subheading}</p>}
    </header>

    {config.items.length > 0 ? (
      <div class={gridClass}>
        {config.items.map((item) =>
          item.kind === "youtube" ? (
            <figure
              class="ps-gallery-item"
              data-gallery-item-kind="youtube"
              data-youtube-video-id={item.videoId}
            >
              <div class="ps-gallery-video-facade">
                {item.posterUrl && (
                  <div class="ps-gallery-frame">
                    <img
                      src={item.posterUrl}
                      alt={item.title}
                      width="1200"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div>
                  <span class="ps-badge">Video YouTube</span>
                  <h3 class="ps-card-title" style="margin-top: 0.5rem;">
                    {item.title}
                  </h3>
                  <p class="ps-card-desc" style="margin-top: 0.25rem;">
                    Video eksternal tidak dimuat otomatis demi privasi pengunjung.
                  </p>
                </div>
                <a
                  href={isPreview ? undefined : `https://www.youtube.com/watch?v=${item.videoId}`}
                  class:list={["ps-btn ps-btn--secondary", isPreview && "ps-btn--inert"]}
                  aria-disabled={isPreview ? "true" : undefined}
                  target={isPreview ? undefined : "_blank"}
                  rel={isPreview ? undefined : "noopener noreferrer"}
                >
                  Tonton di YouTube
                </a>
              </div>
              {item.caption && <figcaption class="ps-gallery-caption">{item.caption}</figcaption>}
            </figure>
          ) : (
            <figure class="ps-gallery-item" data-gallery-item-kind="image">
              <div class="ps-gallery-frame">
                <img
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              {item.caption && <figcaption class="ps-gallery-caption">{item.caption}</figcaption>}
            </figure>
          ),
        )}
      </div>
    ) : (
      <p class="ps-empty-state">Belum ada dokumentasi galeri yang ditambahkan.</p>
    )}
  </div>
</section>
