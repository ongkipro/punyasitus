---
import {
  FLOATING_WA_DEFAULTS,
  resolveFloatingWhatsAppConfig,
  type FloatingWhatsAppProps,
} from "./FloatingWhatsApp.ts";

export type Props = FloatingWhatsAppProps;

const config = resolveFloatingWhatsAppConfig(Astro.props);
---

{config && (
  <aside
    class="wa"
    aria-label={`Kontak WhatsApp ${config.businessName}`}
    data-ps-wa-root
    data-testid="floating-wa-widget"
  >
    {config.hasGreeting ? (
      <details class="wa-d" data-ps-wa-details data-testid="floating-wa-details">
        <summary
          class="wa-btn"
          aria-label={config.triggerAriaLabel}
          data-testid="floating-wa-trigger"
        >
          <svg class="wa-ic" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2a9.9 9.9 0 0 0-8.48 15.02L2 22l5.12-1.5A9.92 9.92 0 1 0 12.04 2Zm0 18.14a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.04.89.91-2.96-.2-.31a8.22 8.22 0 1 1 6.81 3.71Zm4.5-6.15c-.25-.12-1.46-.72-1.69-.8-.22-.08-.39-.12-.55.12s-.63.8-.78.96c-.14.17-.29.19-.54.06a6.72 6.72 0 0 1-3.32-2.9c-.25-.43.25-.4.71-1.33.08-.17.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.66.31s-.86.84-.86 2.05.88 2.38 1 2.54c.13.17 1.73 2.65 4.2 3.71.59.25 1.05.4 1.4.51.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.67-1.17.2-.57.2-1.06.14-1.17-.06-.1-.22-.16-.47-.29Z" />
          </svg>
          <span>{config.buttonLabel}</span>
        </summary>

        <section
          class="wa-card"
          aria-label={`Sapaan WhatsApp ${config.businessName}`}
          data-testid="floating-wa-card"
        >
          <header class="wa-hd">
            <div class="wa-id">
              {config.avatarUrl ? (
                <img
                  src={config.avatarUrl}
                  alt={config.avatarAlt}
                  width="40"
                  height="40"
                  loading="lazy"
                  decoding="async"
                  class="wa-av"
                />
              ) : (
                <span class="wa-av wa-ini" aria-hidden="true">
                  {config.initials}
                </span>
              )}
              <div class="wa-hg">
                <p class="wa-nm" data-testid="floating-wa-name">{config.businessName}</p>
                {config.agentSubtitle && <p class="wa-sub">{config.agentSubtitle}</p>}
              </div>
            </div>

            <button
              type="button"
              class="wa-x"
              aria-label="Tutup sapaan WhatsApp"
              data-ps-wa-close
              data-testid="floating-wa-close"
              hidden
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </header>

          <div class="wa-bd">
            <p class="wa-msg" data-testid="floating-wa-greeting">{config.greetingMessage}</p>

            {(config.operatingHours || config.holidayHours) && (
              <div class="wa-hr" data-testid="floating-wa-hours">
                <svg class="wa-ic wa-clk" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <polyline points="12 7 12 12 15 14" />
                </svg>
                <div class="wa-hl">
                  {config.operatingHours && (
                    <p>
                      <b>{FLOATING_WA_DEFAULTS.hoursHeading}:</b> {config.operatingHours}
                    </p>
                  )}
                  {config.holidayHours && (
                    <p>
                      <b>{FLOATING_WA_DEFAULTS.holidayHeading}:</b> {config.holidayHours}
                    </p>
                  )}
                </div>
              </div>
            )}
          </div>

          <footer class="wa-ft">
            <a
              href={config.waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="wa-cta"
              data-testid="floating-wa-chat-link"
              data-wa-event="wa_click"
            >
              <svg class="wa-ic" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2a9.9 9.9 0 0 0-8.48 15.02L2 22l5.12-1.5A9.92 9.92 0 1 0 12.04 2Zm0 18.14a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.04.89.91-2.96-.2-.31a8.22 8.22 0 1 1 6.81 3.71Zm4.5-6.15c-.25-.12-1.46-.72-1.69-.8-.22-.08-.39-.12-.55.12s-.63.8-.78.96c-.14.17-.29.19-.54.06a6.72 6.72 0 0 1-3.32-2.9c-.25-.43.25-.4.71-1.33.08-.17.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.66.31s-.86.84-.86 2.05.88 2.38 1 2.54c.13.17 1.73 2.65 4.2 3.71.59.25 1.05.4 1.4.51.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.67-1.17.2-.57.2-1.06.14-1.17-.06-.1-.22-.16-.47-.29Z" />
              </svg>
              <span>{config.ctaLabel}</span>
            </a>
            <p class="wa-nt">{FLOATING_WA_DEFAULTS.externalNote}</p>
          </footer>
        </section>
      </details>
    ) : (
      <a
        href={config.waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="wa-btn"
        aria-label={config.triggerAriaLabel}
        data-testid="floating-wa-chat-link"
        data-wa-event="wa_click"
      >
        <svg class="wa-ic" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2a9.9 9.9 0 0 0-8.48 15.02L2 22l5.12-1.5A9.92 9.92 0 1 0 12.04 2Zm0 18.14a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.04.89.91-2.96-.2-.31a8.22 8.22 0 1 1 6.81 3.71Zm4.5-6.15c-.25-.12-1.46-.72-1.69-.8-.22-.08-.39-.12-.55.12s-.63.8-.78.96c-.14.17-.29.19-.54.06a6.72 6.72 0 0 1-3.32-2.9c-.25-.43.25-.4.71-1.33.08-.17.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.66.31s-.86.84-.86 2.05.88 2.38 1 2.54c.13.17 1.73 2.65 4.2 3.71.59.25 1.05.4 1.4.51.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.67-1.17.2-.57.2-1.06.14-1.17-.06-.1-.22-.16-.47-.29Z" />
        </svg>
        <span>{config.buttonLabel}</span>
      </a>
    )}
  </aside>
)}

<style>
.wa,.wa-d{position:relative}
.wa,.wa-bd,.wa-hl,.wa-ft{display:flex;flex-direction:column}
.wa{display:inline-flex;align-items:flex-end}
.wa-btn,.wa-cta,.wa-x,.wa-ini{display:inline-flex;align-items:center;justify-content:center}
.wa-ic,.wa-av,.wa-x{flex-shrink:0}
.wa-nm,.wa-nt,.wa-msg,.wa-hl p{margin:0}
.wa-hg,.wa-hl{min-width:0}
.wa-btn{list-style:none;gap:.5rem;min-height:48px;min-width:48px;padding:.625rem 1rem;border:0;border-radius:999px;background:var(--ps-wa-bg,#0b6b3a);color:var(--ps-wa-fg,#fff);font:600 .9375rem/1.2 inherit;text-decoration:none;cursor:pointer;user-select:none;box-shadow:0 6px 18px rgba(11,107,58,.24)}
.wa-btn::-webkit-details-marker{display:none}
.wa-btn::marker{content:""}
.wa-btn:hover,.wa-cta:hover{filter:brightness(.94);text-decoration:none}
.wa-btn:focus-visible,.wa-cta:focus-visible,.wa-x:focus-visible{outline:2px solid var(--ps-focus-ring);outline-offset:3px}
.wa-x:focus-visible{outline-color:var(--ps-wa-fg,#fff)}
.wa-card{position:absolute;right:0;bottom:calc(100% + .75rem);width:min(21rem,calc(100vw - 2rem));background:var(--ps-surface);color:var(--ps-ink);border:1px solid var(--ps-border);border-radius:var(--ps-radius-lg);box-shadow:0 14px 32px rgba(15,23,42,.16);overflow:hidden}
.wa-hd{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.75rem .75rem .75rem .875rem;background:var(--ps-wa-bg,#0b6b3a);color:var(--ps-wa-fg,#fff)}
.wa-id{display:flex;align-items:center;gap:.625rem;min-width:0}
.wa-av{width:40px;height:40px;border-radius:999px;object-fit:cover;background:rgba(255,255,255,.18)}
.wa-ini{font-size:.875rem;font-weight:700}
.wa-nm{font-size:.9375rem;font-weight:700;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wa-sub{margin:.125rem 0 0;font-size:.75rem;line-height:1.25;opacity:.92}
.wa-x{min-width:44px;min-height:44px;padding:0;border:0;border-radius:var(--ps-radius-sm);background:transparent;color:var(--ps-wa-fg,#fff);cursor:pointer}
.wa-x[hidden]{display:none}
.wa-x:hover{background:rgba(255,255,255,.16)}
.wa-bd{padding:.875rem;gap:.75rem}
.wa-msg{padding:.75rem;background:var(--ps-surface-muted);border:1px solid var(--ps-border);border-radius:var(--ps-radius);font-size:.875rem;line-height:1.5;white-space:pre-line}
.wa-hr{display:flex;align-items:flex-start;gap:.5rem;color:var(--ps-ink-muted);font-size:.8125rem;line-height:1.45}
.wa-clk{margin-top:.125rem}
.wa-hl{gap:.125rem}
.wa-hl b{font-weight:600;color:var(--ps-ink)}
.wa-ft{padding:0 .875rem .875rem;gap:.375rem}
.wa-cta{gap:.5rem;width:100%;min-height:44px;padding:.625rem 1rem;border-radius:var(--ps-radius);background:var(--ps-wa-bg,#0b6b3a);color:var(--ps-wa-fg,#fff);font-size:.9375rem;font-weight:600;text-decoration:none}
.wa-nt{text-align:center;font-size:.75rem;color:var(--ps-ink-muted)}
@media (max-width:1120px){:global(body:has(.ps-consent-banner:not([hidden]))) .wa{margin-bottom:var(--ps-wa-offset,22rem)}}
@media (prefers-reduced-motion:reduce){.wa-btn,.wa-cta,.wa-x{transition:none}}
</style>

<script is:inline>
(() => {
const D=document,q=(p,s)=>p.querySelector(s),on=(t,e,f,o)=>t.addEventListener(e,f,o),go=()=>{
const b=q(D,".ps-consent-banner");
for(const r of D.querySelectorAll("[data-ps-wa-root]")){
if(r.dataset.i)continue;
r.dataset.i="1";
const sync=()=>r.style.setProperty("--ps-wa-offset",b&&!b.hidden?`${Math.max(0,b.offsetHeight-60)}px`:"0px");
sync();
if(b){new MutationObserver(sync).observe(b,{attributeFilter:["hidden"]});on(window,"resize",sync,{passive:true});}
const d=q(r,"details");if(!d)continue;
const s=q(d,"summary"),x=q(r,"button"),hide=(f)=>{if(d.open){d.open=false;if(f)s?.focus();}};
if(x){x.hidden=false;x.onclick=()=>hide(true);}
on(D,"keydown",(e)=>{if(e.key==="Escape"&&d.open){e.preventDefault();hide(true);}});
on(D,"click",(e)=>{if(d.open&&!d.contains(e.target))hide(false);});
}};
if(D.readyState==="loading")on(D,"DOMContentLoaded",go);else go();
})();
</script>
