---
import {
  buildYouTubeWatchUrl,
  isValidYouTubeVideoId,
  sanitizeYouTubePosterUrl,
  YOUTUBE_IFRAME_ALLOW,
  YOUTUBE_IFRAME_REFERRER_POLICY,
  YOUTUBE_PRIVACY_DISCLOSURE_ID,
} from "@punyasitus/core/media/youtube";

/**
 * Privacy-Preserving Click-to-Load YouTube Facade (`YouTubeFacade.astro`).
 *
 * Hard invariants (REQ-089, REQ-021, REQ-039, REQ-040; PLAN §7.3):
 * - Zero iframe elements in initial SSR HTML.
 * - Zero preconnect hints or external YouTube thumbnail images.
 * - Zero network requests to YouTube/Google before explicit visitor click/keyboard activation.
 * - Zero client UI framework runtime on public pages.
 * - Local tenant poster (`/media/...` or `/t/...`) or built-in zero-network SVG placeholder ONLY.
 * - Tiny progressive-enhancement inline script (< 1.5 KiB) mounts `youtube-nocookie.com` iframe on click/Enter/Space.
 * - Works gracefully with JS disabled via outbound fallback link + noscript notice.
 * - Stays completely inert in `mode="preview"`.
 */

export interface Props {
  readonly videoId: string;
  readonly title: string;
  readonly posterUrl?: string | null;
  readonly caption?: string | null;
  readonly mode?: "published" | "preview";
  readonly isPreview?: boolean;
  readonly headingLevel?: "h2" | "h3" | "p";
  readonly context?: "gallery" | "offering" | "post";
  readonly testId?: string;
}

const {
  videoId,
  title,
  posterUrl = null,
  caption = null,
  mode,
  isPreview = false,
  headingLevel = "h3",
  context = "gallery",
  testId,
} = Astro.props;

const validId = isValidYouTubeVideoId(videoId) ? videoId : null;
const safePosterUrl = sanitizeYouTubePosterUrl(posterUrl);
const safeTitle = title.trim() || "Video YouTube";
const safeCaption = caption?.trim() || null;
const previewMode = mode === "preview" || Boolean(isPreview);
const watchUrl = validId ? buildYouTubeWatchUrl(validId) : null;
const rootTestId = testId ?? (validId ? `youtube-facade-${validId}` : "youtube-facade");
const disclosureId = validId ? `ps-yt-note-${context}-${validId}` : undefined;
---

{validId && watchUrl && (
  <article
    class="ps-yt-card"
    data-ps-yt-facade
    data-yt-video-id={validId}
    data-yt-title={safeTitle}
    data-yt-allow={YOUTUBE_IFRAME_ALLOW}
    data-yt-referrer={YOUTUBE_IFRAME_REFERRER_POLICY}
    data-yt-context={context}
    data-yt-state="facade"
    data-yt-preview={previewMode ? "true" : undefined}
    data-testid={rootTestId}
    aria-label={`Video YouTube: ${safeTitle}`}
  >
    <div class="ps-yt-stage" data-ps-yt-stage>
      {safePosterUrl ? (
        <img
          src={safePosterUrl}
          alt={`Poster video: ${safeTitle}`}
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
          class="ps-yt-poster"
        />
      ) : (
        <div class="ps-yt-placeholder" aria-hidden="true">
          <svg
            class="ps-yt-placeholder-svg"
            viewBox="0 0 640 360"
            width="640"
            height="360"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            focusable="false"
          >
            <rect width="640" height="360" fill="#132220" />
            <rect
              x="24"
              y="24"
              width="592"
              height="312"
              rx="14"
              fill="#1b332f"
              stroke="#335750"
              stroke-width="1.5"
            />
            <circle cx="540" cy="84" r="64" fill="#ffffff" fill-opacity="0.05" />
            <circle cx="110" cy="284" r="82" fill="#ffffff" fill-opacity="0.04" />
            <rect x="44" y="44" width="176" height="28" rx="6" fill="#0d1917" fill-opacity="0.72" />
            <circle cx="62" cy="58" r="5" fill="#34d399" />
            <rect x="76" y="54" width="128" height="8" rx="4" fill="#cbd5e1" fill-opacity="0.65" />
            <rect x="44" y="294" width="220" height="8" rx="4" fill="#94a3b8" fill-opacity="0.4" />
            <rect x="44" y="308" width="144" height="6" rx="3" fill="#94a3b8" fill-opacity="0.25" />
          </svg>
        </div>
      )}

      <div class="ps-yt-scrim" aria-hidden="true" />

      <div class="ps-yt-overlay">
        <button
          type="button"
          class:list={["ps-yt-play", previewMode && "ps-yt-play--inert"]}
          data-ps-yt-play
          data-testid={`${rootTestId}-play`}
          aria-label={previewMode ? `Pratinjau video YouTube: ${safeTitle}` : `Putar video YouTube: ${safeTitle}`}
          aria-describedby={disclosureId}
          disabled={previewMode ? true : undefined}
          aria-disabled={previewMode ? "true" : undefined}
        >
          <span class="ps-yt-play-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" focusable="false">
              <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.02-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z" />
            </svg>
          </span>
          <span class="ps-yt-play-text">
            {previewMode ? "Pratinjau Video" : "Putar Video"}
          </span>
        </button>
      </div>
    </div>

    <div class="ps-yt-body">
      <div class="ps-yt-header">
        <span class="ps-yt-badge">Video YouTube</span>
        <span class="ps-yt-host">youtube-nocookie.com</span>
      </div>

      {headingLevel === "h2" ? (
        <h2 class="ps-yt-title">{safeTitle}</h2>
      ) : headingLevel === "p" ? (
        <p class="ps-yt-title">{safeTitle}</p>
      ) : (
        <h3 class="ps-yt-title">{safeTitle}</h3>
      )}

      <p
        id={disclosureId}
        class="ps-yt-disclosure"
        data-testid={`${rootTestId}-disclosure`}
      >
        {YOUTUBE_PRIVACY_DISCLOSURE_ID}
      </p>

      <p class="ps-yt-sr-only" role="status" aria-live="polite" data-ps-yt-status />

      {safeCaption && <p class="ps-yt-caption">{safeCaption}</p>}

      <div class="ps-yt-actions">
        <a
          href={previewMode ? undefined : watchUrl}
          class:list={["ps-btn ps-btn--secondary ps-yt-fallback", previewMode && "ps-btn--inert"]}
          target={previewMode ? undefined : "_blank"}
          rel={previewMode ? undefined : "noopener noreferrer"}
          aria-disabled={previewMode ? "true" : undefined}
          data-testid={`${rootTestId}-fallback-link`}
        >
          Tonton langsung di YouTube
        </a>
      </div>

      <noscript>
        <p class="ps-yt-noscript">
          JavaScript tidak aktif. Gunakan tombol "Tonton langsung di YouTube" di atas untuk memutar video di tab baru.
        </p>
      </noscript>
    </div>
  </article>
)}

<style>
  .ps-yt-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
    height: 100%;
    background-color: var(--ps-surface, #ffffff);
    color: var(--ps-ink, #111c19);
    border-radius: var(--ps-radius, 8px);
    overflow: hidden;
  }

  .ps-yt-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #132220;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ps-yt-poster,
  .ps-yt-placeholder,
  .ps-yt-placeholder-svg,
  .ps-yt-stage :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .ps-yt-poster {
    object-fit: cover;
  }

  .ps-yt-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 23, 42, 0.16) 0%,
      rgba(15, 23, 42, 0.56) 100%
    );
    pointer-events: none;
  }

  .ps-yt-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .ps-yt-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 52px;
    min-width: 52px;
    max-width: 100%;
    padding: 0.625rem 1.25rem 0.625rem 0.75rem;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.92);
    background-color: var(--ps-brand-primary, #176b51);
    color: var(--ps-brand-on-primary, #ffffff);
    font-family: var(--ps-font-sans, system-ui, sans-serif);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.32);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .ps-yt-play:hover:not(:disabled) {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }

  .ps-yt-play:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
    box-shadow: 0 0 0 6px var(--ps-focus-ring, #176b51);
  }

  .ps-yt-play--inert,
  .ps-yt-play:disabled {
    cursor: default;
    opacity: 0.85;
  }

  .ps-yt-play-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.18);
    flex-shrink: 0;
  }

  .ps-yt-play-text {
    white-space: nowrap;
  }

  .ps-yt-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: 0.5rem;
    padding: 1rem 1.125rem 1.125rem;
    min-width: 0;
    background-color: var(--ps-surface-muted, #f4f7f5);
    border-top: 1px solid var(--ps-border, #d8e2dc);
  }

  .ps-yt-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem;
  }

  .ps-yt-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: var(--ps-radius-sm, 6px);
    border: 1px solid var(--ps-border, #d8e2dc);
    background-color: var(--ps-surface, #ffffff);
    color: var(--ps-ink, #111c19);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .ps-yt-host {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ps-ink-muted, #4b5c55);
    font-variant-numeric: tabular-nums;
  }

  .ps-yt-title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ps-ink, #111c19);
    overflow-wrap: anywhere;
  }

  .ps-yt-disclosure {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ps-ink-muted, #4b5c55);
    overflow-wrap: anywhere;
  }

  .ps-yt-caption {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ps-ink, #111c19);
    overflow-wrap: anywhere;
  }

  .ps-yt-actions {
    margin-top: auto;
    padding-top: 0.375rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ps-yt-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    border-radius: var(--ps-radius, 8px);
    border: 1px solid var(--ps-border, #d8e2dc);
    background-color: var(--ps-surface, #ffffff);
    color: var(--ps-ink, #111c19);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    line-height: 1.25;
  }

  .ps-yt-fallback:hover:not([aria-disabled="true"]) {
    border-color: var(--ps-brand-primary, #176b51);
    color: var(--ps-brand-primary, #176b51);
    text-decoration: none;
  }

  .ps-yt-fallback:focus-visible {
    outline: 2px solid var(--ps-focus-ring, #176b51);
    outline-offset: 2px;
  }

  .ps-yt-noscript {
    margin: 0.25rem 0 0;
    padding: 0.5rem 0.625rem;
    border-radius: var(--ps-radius-sm, 6px);
    border: 1px solid var(--ps-border, #d8e2dc);
    background-color: var(--ps-surface, #ffffff);
    color: var(--ps-ink-muted, #4b5c55);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .ps-yt-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ps-yt-play {
      transition: none;
    }
  }
</style>

<script is:inline>
(() => {
const D=document,RE=/^[A-Za-z0-9_-]{11}$/;
if(D.__psYtBound)return;
D.__psYtBound=true;
D.addEventListener("click",(e)=>{
const t=e.target;if(!(t instanceof Element))return;
const b=t.closest("[data-ps-yt-play]");if(!b)return;
const r=b.closest("[data-ps-yt-facade]");if(!r)return;
if(r.dataset.ytPreview==="true"||r.dataset.ytState==="active"||r.closest('[data-preview="true"]'))return;
const id=r.dataset.ytVideoId||"";if(!RE.test(id))return;
const s=r.querySelector("[data-ps-yt-stage]");if(!s)return;
const f=D.createElement("iframe");
f.src=`https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
f.title=r.dataset.ytTitle||"Video YouTube";
f.allow=r.dataset.ytAllow||"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
f.allowFullscreen=true;
f.referrerPolicy=r.dataset.ytReferrer||"strict-origin-when-cross-origin";
f.setAttribute("data-testid","yt-embed-iframe");
r.dataset.ytState="active";
s.replaceChildren(f);
const st=r.querySelector("[data-ps-yt-status]");
if(st)st.textContent="Pemutar YouTube dimuat dari youtube-nocookie.com.";
f.focus?.();
});
})();
</script>
