---
import {
  resolveScheduleInquiryCtaConfig,
  type ScheduleInquiryCtaInput,
} from "./ScheduleInquiryCta.ts";

/**
 * Zero-JS-Ready WhatsApp Schedule Inquiry CTA (`REQ-072`, `TASK-071`).
 *
 * - Renders a clean `https://wa.me/<digits>?text=<encoded>` anchor at SSR time WITHOUT
 *   any unfilled schedule token sentences so it works 100% when JavaScript is disabled.
 * - Exposes validated `data-wa-*` attributes so the progressive-enhancement form script
 *   can update the href with single-pass token expansion when the visitor selects
 *   optional schedule fields.
 */

export interface Props extends ScheduleInquiryCtaInput {
  readonly formId?: string;
  readonly isPreview?: boolean;
}

const { formId = "formulir-kontak", isPreview = false, ...ctaInput } = Astro.props;
const config = resolveScheduleInquiryCtaConfig(ctaInput);
---

{config && (
  <div class="ps-wa-schedule-box" data-testid="lead-wa-schedule-box">
    <div class="ps-wa-schedule-copy">
      <p class="ps-wa-schedule-title">Atau Kirim Permintaan Jadwal via WhatsApp</p>
      <p class="ps-wa-schedule-desc">
        Pilihan tanggal, waktu, atau cabang di atas akan disertakan otomatis sebagai permintaan
        jadwal saat membuka WhatsApp (tanpa konfirmasi slot otomatis).
      </p>
    </div>
    <a
      href={isPreview ? undefined : config.waUrl}
      target={isPreview ? undefined : "_blank"}
      rel={isPreview ? undefined : "noopener noreferrer"}
      aria-disabled={isPreview ? "true" : undefined}
      class:list={[
        "ps-btn ps-btn--whatsapp ps-wa-schedule-cta",
        isPreview && "ps-btn--inert",
      ]}
      data-testid="lead-wa-schedule-cta"
      data-wa-schedule-link="true"
      data-wa-form-id={formId}
      data-wa-phone={config.phone}
      data-wa-template={config.template}
      data-wa-item-title={config.itemTitle}
      data-wa-page-url={config.pageUrl}
      data-wa-default-href={config.waUrl}
      data-wa-event="wa_click"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        class="ps-wa-schedule-icon"
      >
        <path d="M12.04 2a9.9 9.9 0 0 0-8.48 15.02L2 22l5.12-1.5A9.92 9.92 0 1 0 12.04 2Zm0 18.14a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.04.89.91-2.96-.2-.31a8.22 8.22 0 1 1 6.81 3.71Zm4.5-6.15c-.25-.12-1.46-.72-1.69-.8-.22-.08-.39-.12-.55.12s-.63.8-.78.96c-.14.17-.29.19-.54.06a6.72 6.72 0 0 1-3.32-2.9c-.25-.43.25-.4.71-1.33.08-.17.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.66.31s-.86.84-.86 2.05.88 2.38 1 2.54c.13.17 1.73 2.65 4.2 3.71.59.25 1.05.4 1.4.51.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.67-1.17.2-.57.2-1.06.14-1.17-.06-.1-.22-.16-.47-.29Z" />
      </svg>
      <span>{config.ctaLabel}</span>
    </a>
  </div>
)}

<style>
  .ps-wa-schedule-box {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ps-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .ps-wa-schedule-copy {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .ps-wa-schedule-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ps-ink);
  }

  .ps-wa-schedule-desc {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ps-ink-muted);
  }

  .ps-wa-schedule-cta {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    min-height: 44px;
  }

  .ps-wa-schedule-icon {
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .ps-wa-schedule-box {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .ps-wa-schedule-cta {
      width: auto;
      flex-shrink: 0;
    }
  }
</style>
