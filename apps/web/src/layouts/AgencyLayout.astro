---
import "../styles/admin/globals.css";
import { AdminShell, type AdminShellProps } from "@/components/admin/AdminShell";

export interface Props
  extends Omit<
    AdminShellProps,
    "surface" | "lifecycleStatus" | "lifecycleDaysRemaining" | "lifecycleReason" | "children"
  > {
  title: string;
}

const {
  title,
  workspaceName,
  workspaceSubtitle = "Portal Agensi PunyaSitus",
  activeNavId = "home",
  basePath = "/agency",
  agencyClientContext,
  publicSiteHref,
  userDisplayName = "Admin Agensi",
  userRoleLabel = "Admin Agensi",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23176b51'/%3E%3Ctext x='16' y='21' text-anchor='middle' font-family='sans-serif' font-size='13' font-weight='700' fill='%23ffffff'%3EAG%3C/text%3E%3C/svg%3E"
    />
    <title>{title} — Portal Agensi PunyaSitus</title>
  </head>
  <body>
    <AdminShell
      client:load
      surface="agency"
      workspaceName={workspaceName}
      workspaceSubtitle={workspaceSubtitle}
      activeNavId={activeNavId}
      basePath={basePath}
      agencyClientContext={agencyClientContext}
      publicSiteHref={publicSiteHref}
      userDisplayName={userDisplayName}
      userRoleLabel={userRoleLabel}
    >
      <slot />
    </AdminShell>
  </body>
</html>
