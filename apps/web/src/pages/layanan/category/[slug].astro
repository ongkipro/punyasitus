---
import { env } from "cloudflare:workers";
import { enrichPublicOfferingCategoryArchiveResult } from "../../../components/seo/public-seo-context.ts";
import {
  applyPublicRouteResponseMeta,
  buildPublicRouteDepsFromAstro,
} from "../../../core/public-routes.ts";
import { resolveOfferingCategoryArchiveRoute } from "../../blog/category/_archive-resolver.ts";
import PublicNotFoundView from "../_PublicNotFoundView.astro";
import OfferingCategoryArchiveView from "./_OfferingCategoryArchiveView.astro";

const deps = buildPublicRouteDepsFromAstro(
  Astro.locals,
  env as unknown as Record<string, unknown>,
);
const result = await resolveOfferingCategoryArchiveRoute(
  Astro.request,
  deps,
  "service",
  Astro.params.slug,
  { url: Astro.url },
);

if (result.kind === "response") {
  return result.response;
}

applyPublicRouteResponseMeta(Astro.response, result.http);
const enriched =
  result.kind === "offering_category_archive"
    ? await enrichPublicOfferingCategoryArchiveResult(result, deps)
    : null;
---

{result.kind === "not_found" ? (
  <PublicNotFoundView result={result} />
) : (
  <OfferingCategoryArchiveView result={result} headProps={enriched?.head ?? null} />
)}
