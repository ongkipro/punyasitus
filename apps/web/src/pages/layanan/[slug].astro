---
import { env } from "cloudflare:workers";
import type { ServiceConsultationAttributes } from "@punyasitus/core/catalog/service";
import { createTenantDb, openTenantStoreStub } from "@punyasitus/db/connections";
import { enrichPublicOfferingDetailResult } from "../../components/seo/public-seo-context.ts";
import {
  applyPublicRouteResponseMeta,
  buildPublicRouteDepsFromAstro,
  resolveOfferingDetailRoute,
} from "../../core/public-routes.ts";
import { loadFrozenPublishedServiceBySlug } from "../dashboard/[handle]/catalog/services/_api-handler.ts";
import OfferingDetailView from "./_OfferingDetailView.astro";
import PublicNotFoundView from "./_PublicNotFoundView.astro";

const deps = buildPublicRouteDepsFromAstro(
  Astro.locals,
  env as unknown as Record<string, unknown>,
);
const result = await resolveOfferingDetailRoute(
  Astro.request,
  deps,
  "service",
  Astro.params.slug ?? "",
  { url: Astro.url },
);

if (result.kind === "response") {
  return result.response;
}

applyPublicRouteResponseMeta(Astro.response, result.http);
const enriched =
  result.kind === "offering_detail"
    ? await enrichPublicOfferingDetailResult(result, deps)
    : null;

let publishedServiceConsultation: ServiceConsultationAttributes | null = null;
if (result.kind === "offering_detail") {
  const tenantDb =
    deps.tenantDb ??
    (deps.tenantStore
      ? createTenantDb(openTenantStoreStub(deps.tenantStore, result.tenant.id))
      : null);
  if (tenantDb) {
    publishedServiceConsultation = await loadFrozenPublishedServiceBySlug(
      tenantDb,
      result.offering.slug,
    );
  }
}
---

{result.kind === "not_found" ? (
  <PublicNotFoundView result={result} />
) : (
  <OfferingDetailView
    result={result}
    headProps={enriched?.head ?? null}
    categoryLinks={enriched?.categoryLinks ?? []}
    sanitizedDescriptionHtml={enriched?.sanitizedDescriptionHtml ?? null}
    serviceConsultation={publishedServiceConsultation}
  />
)}
