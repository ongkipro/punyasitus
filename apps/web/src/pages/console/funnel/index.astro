---
import { env } from "cloudflare:workers";
import type { ConsoleRuntimeEnv } from "@punyasitus/auth/platform/index";
import type { CloudflareSendEmailBinding } from "@punyasitus/core/email/index";
import { FUNNEL_RANGE_OPTIONS } from "@punyasitus/core/marketing/index";
import ConsoleLayout from "../../../layouts/ConsoleLayout.astro";
import { loadConsoleFunnelViewData } from "./_handler";

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const runtimeEnv = env as typeof env & {
  readonly AUTH_SECRET?: string;
  readonly CONSOLE_AUTH_SECRET?: string;
};

const consoleEnv: ConsoleRuntimeEnv = {
  APP_ENV: runtimeEnv.APP_ENV,
  PLATFORM_DOMAIN: runtimeEnv.PLATFORM_DOMAIN,
  PLATFORM_DB: runtimeEnv.PLATFORM_DB,
  BACKUP_BUCKET: runtimeEnv.BACKUP_BUCKET,
  AUTH_SECRET: runtimeEnv.AUTH_SECRET,
  CONSOLE_AUTH_SECRET: runtimeEnv.CONSOLE_AUTH_SECRET,
  EMAIL: runtimeEnv.EMAIL as unknown as CloudflareSendEmailBinding | undefined,
};

const loaded = await loadConsoleFunnelViewData(Astro.request, consoleEnv, {
  session: Astro.locals.authSession
    ? { id: Astro.locals.authSession.id, userId: Astro.locals.authSession.userId }
    : null,
  user: Astro.locals.authUser
    ? { id: Astro.locals.authUser.id, email: Astro.locals.authUser.email }
    : null,
});

if (!loaded.ok) {
  return loaded.deniedResponse;
}

const { host, actorName, actorRoleLabel, stepUpFresh, rangeDays, summary } = loaded;

const maxStageCount = Math.max(1, ...summary.stages.map((s) => s.count));
const visitStage = summary.stages.find((s) => s.stage === "visit");
const demoStage = summary.stages.find((s) => s.stage === "demo_view");
const signupStage = summary.stages.find((s) => s.stage === "signup_start");
const paidStage = summary.stages.find((s) => s.stage === "first_payment");

const navLinks = [
  { href: "/console", label: "Ringkasan", current: false },
  { href: "/console/funnel", label: "Funnel", current: true },
  { href: "/console/operators", label: "Operator", current: false },
  { href: "/console/audit", label: "Audit Log", current: false },
  { href: "/console/health", label: "Kesehatan", current: false },
  { href: "/console/settings", label: "Pengaturan", current: false },
];
---

<ConsoleLayout
  title="Analitik Funnel Pemasaran"
  workspaceSubtitle={host}
  activeNavId="home"
  basePath="/console"
  userDisplayName={actorName}
  userRoleLabel={actorRoleLabel}
>
  <div class="space-y-5" data-testid="console-funnel-page">
    <!-- Explicit Platform Context Banner (non-impersonation) -->
    <section
      data-testid="console-context-banner"
      aria-label="Konteks akses platform"
      class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-warning-border bg-warning-soft px-4 py-3 text-xs text-warning md:text-sm"
    >
      <p class="font-medium">
        Console Operasional Platform — Akses istimewa — bukan penyamaran akun tenant
      </p>
      <span class="rounded border border-warning-border bg-card px-2 py-0.5 text-xs font-medium text-foreground">
        {stepUpFresh ? "2FA Step-Up Aktif (<10m)" : "2FA Terverifikasi"}
      </span>
    </section>

    <!-- Console Section Navigation -->
    <nav
      aria-label="Navigasi modul console"
      data-testid="console-section-nav"
      class="flex flex-wrap items-center gap-2 border-b border-border pb-3"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={link.current ? "page" : undefined}
          class:list={[
            "inline-flex min-h-11 items-center rounded-md border px-3.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:min-h-9",
            link.current
              ? "border-primary bg-primary text-primary-foreground"
              : "border-border bg-card text-foreground hover:bg-muted",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Page Header + Date Range Selector -->
    <header class="flex flex-wrap items-start justify-between gap-3">
      <div class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight text-foreground">
          Analitik Funnel Pemasaran (Tanpa Cookie)
        </h1>
        <p class="text-sm text-muted-foreground">
          Penghitung agregat harian <code class="font-mono">marketing_funnel_daily</code> ({summary.startDayUtc} s/d {summary.endDayUtc} UTC) — tanpa cookie, alamat IP, atau PII pengunjung.
        </p>
      </div>

      <nav aria-label="Pilih rentang hari funnel" class="flex flex-wrap items-center gap-2" data-testid="funnel-range-selector">
        {FUNNEL_RANGE_OPTIONS.map((days) => {
          const active = rangeDays === days;
          return (
            <a
              href={`/console/funnel?range=${days}`}
              aria-current={active ? "page" : undefined}
              data-testid={`funnel-range-${days}d`}
              class:list={[
                "inline-flex min-h-11 items-center rounded-md border px-3 text-xs font-medium tabular-nums transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:min-h-9",
                active
                  ? "border-primary bg-primary text-primary-foreground"
                  : "border-border bg-card text-foreground hover:bg-muted",
              ]}
            >
              {days} Hari
            </a>
          );
        })}
      </nav>
    </header>

    <!-- Summary KPI Strip -->
    <section aria-label="Ringkasan metrik funnel" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-lg border border-border bg-card p-4">
        <p class="text-xs font-medium text-muted-foreground">Kunjungan (visit)</p>
        <p class="mt-1 text-2xl font-semibold tabular-nums text-foreground" data-testid="funnel-kpi-visit">
          {visitStage?.count ?? 0}
        </p>
        <p class="mt-1 text-xs text-muted-foreground tabular-nums">
          Total event {rangeDays}h: {summary.totalEvents}
        </p>
      </div>

      <div class="rounded-lg border border-border bg-card p-4">
        <p class="text-xs font-medium text-muted-foreground">Lihat Demo (demo_view)</p>
        <p class="mt-1 text-2xl font-semibold tabular-nums text-foreground" data-testid="funnel-kpi-demo">
          {demoStage?.count ?? 0}
        </p>
        <p class="mt-1 text-xs text-muted-foreground tabular-nums">
          Konversi dari kunjungan: {demoStage?.stepConversionPct ?? 0}%
        </p>
      </div>

      <div class="rounded-lg border border-border bg-card p-4">
        <p class="text-xs font-medium text-muted-foreground">Mulai Daftar (signup_start)</p>
        <p class="mt-1 text-2xl font-semibold tabular-nums text-foreground" data-testid="funnel-kpi-signup">
          {signupStage?.count ?? 0}
        </p>
        <p class="mt-1 text-xs text-muted-foreground tabular-nums">
          Konversi dari demo: {signupStage?.stepConversionPct ?? 0}%
        </p>
      </div>

      <div class="rounded-lg border border-border bg-card p-4">
        <p class="text-xs font-medium text-muted-foreground">Pembayaran Pertama (first_payment)</p>
        <p class="mt-1 text-2xl font-semibold tabular-nums text-foreground" data-testid="funnel-kpi-paid">
          {paidStage?.count ?? 0}
        </p>
        <p class="mt-1 text-xs text-muted-foreground tabular-nums">
          Kunjungan &rarr; Bayar: {summary.visitToFirstPaymentPct}%
        </p>
      </div>
    </section>

    <!-- Stage-by-Stage Funnel Bars & Conversion Table -->
    <section aria-label="Tahapan konversi funnel" class="rounded-lg border border-border bg-card p-4">
      <div class="border-b border-border pb-3">
        <h2 class="text-base font-semibold text-foreground">
          Tahapan Funnel ({rangeDays} Hari Terakhir)
        </h2>
        <p class="text-xs text-muted-foreground">
          Urutan kanonis: visit &rarr; demo_view &rarr; signup_start &rarr; email_verified &rarr; trial_created &rarr; first_payment
        </p>
      </div>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[600px] border-collapse text-left text-sm" data-testid="funnel-stages-table">
          <thead>
            <tr class="border-b border-border text-xs font-semibold text-muted-foreground">
              <th class="py-2 pr-4">Tahap</th>
              <th class="py-2 pr-4 text-right">Jumlah</th>
              <th class="py-2 pr-4">Proporsi Visual</th>
              <th class="py-2 pr-4 text-right">Konversi Tahap</th>
              <th class="py-2 text-right">Dari Visit</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {summary.stages.map((row) => {
              const barWidthPct = row.count === 0 ? 0 : Math.max(4, Math.round((row.count / maxStageCount) * 100));
              return (
                <tr data-testid={`funnel-stage-row-${row.stage}`}>
                  <td class="py-3 pr-4">
                    <p class="font-medium text-foreground">{row.label}</p>
                    <p class="font-mono text-xs text-muted-foreground">{row.stage}</p>
                  </td>
                  <td class="py-3 pr-4 text-right font-semibold tabular-nums text-foreground" data-testid={`funnel-stage-count-${row.stage}`}>
                    {row.count}
                  </td>
                  <td class="py-3 pr-4 w-56">
                    <div class="h-3 w-full overflow-hidden rounded bg-muted" aria-hidden="true">
                      <div
                        class="h-full rounded bg-primary"
                        style={`width: ${barWidthPct}%;`}
                      />
                    </div>
                  </td>
                  <td class="py-3 pr-4 text-right tabular-nums text-muted-foreground">
                    {row.stepConversionPct === null ? "—" : `${row.stepConversionPct}%`}
                  </td>
                  <td class="py-3 text-right tabular-nums text-muted-foreground">
                    {row.overallConversionPct}%
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Theme Demo Interest & Source Channels -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <!-- Per-theme breakdown -->
      <section aria-label="Minat demo per tema" class="rounded-lg border border-border bg-card p-4">
        <div class="border-b border-border pb-3">
          <h2 class="text-base font-semibold text-foreground">Minat Demo per Tema (6 Tema Platform)</h2>
          <p class="text-xs text-muted-foreground">Menunjukkan tema demo yang paling banyak dilihat dan memicu pendaftaran.</p>
        </div>

        <div class="mt-3 overflow-x-auto">
          <table class="w-full border-collapse text-left text-sm" data-testid="funnel-themes-table">
            <thead>
              <tr class="border-b border-border text-xs font-semibold text-muted-foreground">
                <th class="py-2 pr-3">Tema</th>
                <th class="py-2 pr-3 text-right">Demo Dilihat</th>
                <th class="py-2 pr-3 text-right">Mulai Daftar</th>
                <th class="py-2 text-right">Porsi Demo</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {summary.themes.map((theme) => (
                <tr data-testid={`funnel-theme-row-${theme.themeSlug}`}>
                  <td class="py-2.5 pr-3">
                    <p class="font-medium text-foreground">{theme.themeName}</p>
                    <p class="text-xs text-muted-foreground">{theme.businessName}</p>
                  </td>
                  <td class="py-2.5 pr-3 text-right font-semibold tabular-nums text-foreground">
                    {theme.demoViews}
                  </td>
                  <td class="py-2.5 pr-3 text-right tabular-nums text-muted-foreground">
                    {theme.signupStarts}
                  </td>
                  <td class="py-2.5 text-right tabular-nums text-muted-foreground">
                    {theme.sharePct}%
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Source Channel breakdown -->
      <section aria-label="Kanal sumber trafik" class="rounded-lg border border-border bg-card p-4">
        <div class="border-b border-border pb-3">
          <h2 class="text-base font-semibold text-foreground">Kanal Sumber Trafik (Tanpa PII)</h2>
          <p class="text-xs text-muted-foreground">Diklasifikasikan dari token UTM/referrer bersih tanpa menyimpan URL mentah atau cookie.</p>
        </div>

        {summary.sources.length === 0 ? (
          <p class="pt-4 text-sm text-muted-foreground">
            Belum ada event funnel tercatat pada rentang {rangeDays} hari ini.
          </p>
        ) : (
          <ul class="divide-y divide-border pt-2" data-testid="funnel-sources-list">
            {summary.sources.map((src) => (
              <li class="flex items-center justify-between gap-3 py-2.5 text-sm">
                <span class="font-mono text-xs font-medium text-foreground">{src.sourceChannel}</span>
                <span class="tabular-nums text-muted-foreground">
                  <strong class="text-foreground">{src.totalEvents}</strong> ({src.sharePct}%)
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  </div>
</ConsoleLayout>
