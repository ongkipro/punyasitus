---
import { env } from "cloudflare:workers";
import {
  authorizeConsoleRequest,
  DEFAULT_SECOND_FACTOR_WINDOW_MS,
} from "@punyasitus/auth/platform/index";
import {
  getTenantSeatUsageForServiceRequest,
  listConsoleCustomThemeRequests,
  listCustomThemePackages,
  listTenantActiveCustomThemeGrants,
  type TenantCustomThemeGrantSummary,
  type TenantServiceSeatUsage,
} from "@punyasitus/db/custom-themes/index";
import { listConsoleThemeStoreOverview } from "@punyasitus/db/themes/store/index";
import { ConsoleCustomThemesPanel } from "@/components/admin/custom-theme";
import ConsoleLayout from "@/layouts/ConsoleLayout.astro";
import {
  formatConsolePackageDto,
  formatConsoleRequestDto,
  resolveConsoleCustomThemesRuntimeEnv,
} from "../../api/console/custom-themes/_shared";

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const consoleEnv = resolveConsoleCustomThemesRuntimeEnv(
  env as unknown as Record<string, unknown>,
);

const authz = await authorizeConsoleRequest(
  Astro.request,
  consoleEnv,
  { action: "console.custom_themes.view", requireStepUp: false },
  {
    session: Astro.locals.authSession
      ? { id: Astro.locals.authSession.id, userId: Astro.locals.authSession.userId }
      : null,
    user: Astro.locals.authUser
      ? { id: Astro.locals.authUser.id, email: Astro.locals.authUser.email }
      : null,
  },
);

if (!authz.ok) {
  // CRITICAL R3 INVARIANT: Non-console hosts MUST return a bare neutral 404 (zero Console disclosure!)
  if (authz.response.status === 404) {
    return new Response("Not Found", {
      status: 404,
      headers: {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "private, no-store",
        "X-Robots-Tag": "noindex, nofollow",
      },
    });
  }
  return new Response(
    `<!doctype html><html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>Akses Console Operasional Dibatasi</title></head><body><main><h1>Akses Console Operasional Dibatasi</h1><p>Halaman layanan tema kustom hanya tersedia bagi operator platform aktif dengan 2FA terverifikasi di host console.</p></main></body></html>`,
    {
      status: authz.response.status,
      headers: {
        "Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "private, no-store",
        "X-Robots-Tag": "noindex, nofollow",
      },
    },
  );
}

const { actor, platformDb, nowMs, host } = authz.ctx;
const [rawPackages, rawRequests, storeOverview] = await Promise.all([
  listCustomThemePackages(platformDb, { limit: 100 }),
  listConsoleCustomThemeRequests(platformDb, { limit: 100 }),
  listConsoleThemeStoreOverview(platformDb),
]);
const paidCatalogItems = storeOverview.catalog.filter((item) => item.tier === "paid_once");

const distinctTenantIds = Array.from(new Set(rawRequests.map((r) => r.tenantId)));
const enrichmentEntries = await Promise.all(
  distinctTenantIds.map(async (tid) => {
    const [grants, seats] = await Promise.all([
      listTenantActiveCustomThemeGrants(platformDb, tid),
      getTenantSeatUsageForServiceRequest(platformDb, { tenantId: tid, nowMs }),
    ]);
    return [tid, { grants, seats }] as const;
  }),
);
const enrichmentByTenant = new Map<
  string,
  { readonly grants: readonly TenantCustomThemeGrantSummary[]; readonly seats: TenantServiceSeatUsage | null }
>(enrichmentEntries);

const initialPackages = rawPackages.map(formatConsolePackageDto);
const initialRequests = rawRequests.map((req) => {
  const enriched = enrichmentByTenant.get(req.tenantId);
  return formatConsoleRequestDto(req, enriched?.grants ?? [], enriched?.seats ?? null);
});

const stepUpFresh =
  actor.twoFactorVerifiedAtMs !== null &&
  nowMs - actor.twoFactorVerifiedAtMs <= DEFAULT_SECOND_FACTOR_WINDOW_MS;

const navLinks = [
  { href: "/console", label: "Ringkasan", current: false },
  { href: "/console/custom-themes", label: "Tema Kustom", current: true },
  { href: "/console/billing", label: "Tagihan", current: false },
  { href: "/console/coupons", label: "Kupon Promo", current: false },
  { href: "/console/operators", label: "Operator", current: false },
  { href: "/console/audit", label: "Audit Log", current: false },
  { href: "/console/health", label: "Kesehatan", current: false },
  { href: "/console/settings", label: "Pengaturan", current: false },
];
---

<ConsoleLayout
  title="Layanan & Permintaan Tema Kustom"
  workspaceSubtitle={host.host}
  activeNavId="settings"
  basePath="/console"
  userDisplayName={actor.grant.name ?? actor.grant.email ?? "Operator Platform"}
  userRoleLabel={actor.grant.role === "platform_support" ? "Dukungan Platform" : "Superadmin Platform"}
>
  <div class="space-y-5" data-testid="console-custom-themes-page">
    <section
      data-testid="console-context-banner"
      aria-label="Konteks akses platform"
      class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-warning-border bg-warning-soft px-4 py-3 text-xs text-warning md:text-sm"
    >
      <p class="font-medium">
        Console Operasional Platform — Akses istimewa — bukan penyamaran akun tenant
      </p>
      <span class="rounded border border-warning-border bg-card px-2 py-0.5 text-xs font-medium text-foreground">
        {stepUpFresh ? "2FA Step-Up Aktif (<10m)" : "2FA Perlu Verifikasi Ulang"}
      </span>
    </section>

    <nav
      aria-label="Navigasi modul console"
      data-testid="console-section-nav"
      class="flex flex-wrap items-center gap-2 border-b border-border pb-3"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={link.current ? "page" : undefined}
            class:list={[
              "inline-flex min-h-11 items-center rounded-md border px-3.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:min-h-9",
              link.current
                ? "border-primary bg-primary text-primary-foreground"
                : "border-border bg-card text-foreground hover:bg-muted",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <header class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight text-foreground">
        Layanan Tema Kustom &amp; Terima Beres
      </h1>
      <p class="text-sm text-muted-foreground">
        Kelola paket jasa Tema Kustom dan Layanan Terima Beres (Setup Website) serta proses antrean
        permintaan tenant. Permintaan <strong>Tema Kustom</strong> berstatus Diserahkan wajib
        menautkan izin tema kustom aktif; permintaan <strong>Terima Beres</strong> diselesaikan
        tanpa izin tema dan otomatis mencabut keanggotaan sementara Tim Setup.
      </p>
    </header>

    <section
      data-testid="console-theme-store-overview"
      aria-label="Ringkasan Katalog Tema Premium dan Lisensi"
      class="rounded-lg border border-border bg-card p-4 space-y-3"
    >
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="text-base font-semibold text-foreground">
            Katalog Toko Tema Premium (Beli Sekali) &amp; Lisensi Aktif
          </h2>
          <p class="text-xs text-muted-foreground">
            Lisensi berlaku ketat per website (<code>tenant_theme_entitlements</code>). Endpoint
            operator: <code>/api/console/custom-themes/store</code> (2FA step-up + CSRF).
          </p>
        </div>
        <div class="flex flex-wrap gap-2 text-xs tabular-nums">
          <span class="rounded border border-border bg-muted px-2.5 py-1 font-medium text-foreground">
            {paidCatalogItems.length} tema premium
          </span>
          <span class="rounded border border-border bg-muted px-2.5 py-1 font-medium text-foreground">
            {storeOverview.entitlements.length} lisensi aktif
          </span>
          <span class="rounded border border-border bg-muted px-2.5 py-1 font-medium text-foreground">
            {storeOverview.recentReceipts.length} kuitansi terbit
          </span>
        </div>
      </div>
      {paidCatalogItems.length > 0 && (
        <div class="grid gap-2 sm:grid-cols-2">
          {paidCatalogItems.map((item) => (
            <div class="flex items-center justify-between rounded-md border border-border bg-background px-3 py-2 text-xs">
              <div class="min-w-0">
                <p class="truncate font-semibold text-foreground">{item.name}</p>
                <p class="text-muted-foreground">{item.id}</p>
              </div>
              <span class="shrink-0 font-semibold text-foreground tabular-nums">
                Rp {new Intl.NumberFormat("id-ID").format(item.priceIdr)}
              </span>
            </div>
          ))}
        </div>
      )}
    </section>

    <ConsoleCustomThemesPanel
      client:load
      initialPackages={initialPackages}
      initialRequests={initialRequests}
      stepUpFresh={stepUpFresh}
    />
  </div>
</ConsoleLayout>
