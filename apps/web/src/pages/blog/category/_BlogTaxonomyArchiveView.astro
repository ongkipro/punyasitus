---
import "../../../themes/default/sections/sections.css";
import "../../layanan/_public-pages.css";
import PublicSeoHead from "../../../components/seo/PublicSeoHead.astro";
import type { PublicSeoHeadProps } from "../../../components/seo/public-seo-context.ts";
import FloatingWhatsApp from "../../../themes/default/components/FloatingWhatsApp.astro";
import Layout from "../../../themes/default/Layout.astro";
import PublicBreadcrumbs from "../../layanan/_PublicBreadcrumbs.astro";
import PublicPagination from "../../layanan/_PublicPagination.astro";
import type { PublicBlogTaxonomyArchiveRenderResult } from "./_archive-resolver.ts";

export interface Props {
  readonly result: PublicBlogTaxonomyArchiveRenderResult;
  readonly headProps?: PublicSeoHeadProps | null;
}

const { result, headProps = null } = Astro.props;
const isCategory = result.taxonomyKind === "post_category";
const kindLabel = isCategory ? "Kategori Blog" : "Tag Blog";
---

<Layout
  shell={result.shell}
  pageTitle={result.pageTitle}
  pageDescription={result.seoMetadata.description || undefined}
  managedHead={true}
  currentPath={result.currentPath}
  initialCookieHeader={Astro.request.headers.get("cookie")}
>
  <PublicSeoHead
    slot="head"
    metadata={headProps?.metadata ?? result.seoMetadata}
    schemaGraph={headProps?.schemaGraph ?? result.schemaGraph}
    seoAutopilotEnabled={headProps?.seoAutopilotEnabled ?? true}
    publishedVerificationTokens={headProps?.publishedVerificationTokens ?? null}
    blogEnabled={headProps?.blogEnabled ?? result.shell.site.blogEnabled}
    siteName={headProps?.siteName ?? result.shell.site.title}
    searchAppearance={headProps?.searchAppearance ?? null}
    templateValues={headProps?.templateValues}
  />

  <section
    class="ps-route-hero"
    data-testid={isCategory ? "blog-category-archive-hero" : "blog-tag-archive-hero"}
    data-taxonomy-slug={result.taxonomy.slug}
  >
    <div class="ps-container ps-route-hero-inner">
      <PublicBreadcrumbs items={result.breadcrumbs} />
      <p class="ps-badge" style="width: fit-content; margin-bottom: 0.5rem;">{kindLabel}</p>
      <h1 class="ps-route-title">{result.taxonomy.name}</h1>
      <p class="ps-route-lead">
        {result.taxonomy.description ??
          `Kumpulan artikel terbit pada ${kindLabel.toLowerCase()} ${result.taxonomy.name}.`}
      </p>

      {result.childCategories.length > 0 && (
        <nav
          aria-label="Sub-kategori terkait"
          data-testid="taxonomy-child-links"
          style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem;"
        >
          {result.childCategories.map((child) => (
            <a href={child.href} class="ps-btn ps-btn--secondary" style="min-height: 44px;">
              {child.name} ({child.publishedCount})
            </a>
          ))}
        </nav>
      )}
    </div>
  </section>

  <section class="ps-archive-section" data-testid="blog-taxonomy-archive-section">
    <div class="ps-container">
      {result.items.length > 0 ? (
        <>
          <p class="ps-archive-summary" data-testid="taxonomy-archive-summary">
            Menampilkan {result.items.length} dari {result.pagination.totalItems} artikel
            {result.pagination.totalPages > 1
              ? ` • Halaman ${result.pagination.page} dari ${result.pagination.totalPages}`
              : ""}
          </p>

          <div class="ps-archive-grid" data-testid="blog-taxonomy-archive-grid">
            {result.items.map((post) => (
              <article
                class="ps-card ps-post-card"
                data-testid="blog-post-card"
                data-post-slug={post.slug}
              >
                {post.coverImage && (
                  <div class="ps-offering-media">
                    <img
                      src={post.coverImage.url}
                      alt={post.coverImage.alt || post.title}
                      width={post.coverImage.width}
                      height={post.coverImage.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="ps-post-body">
                  {post.categoryName && (
                    <div>
                      <span class="ps-badge">{post.categoryName}</span>
                    </div>
                  )}
                  <h2 class="ps-card-title">
                    <a
                      href={post.href}
                      class="ps-offering-title-link"
                      data-testid="blog-card-link"
                    >
                      {post.title}
                    </a>
                  </h2>
                  {post.excerpt && <p class="ps-card-desc">{post.excerpt}</p>}
                  <div class="ps-post-meta">
                    {post.authorName && <span>{post.authorName}</span>}
                    {post.publishedDateLabel && (
                      <time datetime={post.publishedAtIso ?? undefined}>
                        {post.publishedDateLabel}
                      </time>
                    )}
                    <span>{post.readingTimeMinutes} menit baca</span>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <PublicPagination
            pagination={result.pagination}
            ariaLabel={`Navigasi halaman arsip ${result.taxonomy.name}`}
          />
        </>
      ) : (
        <div class="ps-state-panel" data-testid="taxonomy-empty-state">
          <h2 class="ps-state-heading">Belum ada artikel di {result.taxonomy.name}</h2>
          <p class="ps-state-body">
            Artikel yang diterbitkan pada {kindLabel.toLowerCase()} ini akan otomatis tampil di
            halaman ini.
          </p>
          <div class="ps-actions">
            <a href="/blog" class="ps-btn ps-btn--primary">
              Lihat Semua Artikel
            </a>
            <a href="/" class="ps-btn ps-btn--secondary">
              Kembali ke Beranda
            </a>
          </div>
        </div>
      )}
    </div>
  </section>

  {result.floatingWa.phone && (
    <FloatingWhatsApp
      slot="floating"
      shell={result.shell}
      phone={result.floatingWa.phone}
      businessName={result.floatingWa.businessName}
      greetingMessage={result.floatingWa.greetingMessage}
      operatingHours={result.floatingWa.operatingHours}
      holidayHours={result.floatingWa.holidayHours}
      primaryOrigin={result.floatingWa.primaryOrigin}
      canonicalPath={result.floatingWa.canonicalPath}
      itemTitle={result.floatingWa.itemTitle}
    />
  )}
</Layout>
