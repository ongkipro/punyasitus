---
import { env } from "cloudflare:workers";
import "../themes/default/sections/sections.css";
import "./layanan/_public-pages.css";
import PublicSeoHead from "../components/seo/PublicSeoHead.astro";
import { enrichPublicPageRouteResult } from "../components/seo/public-seo-context.ts";
import {
  applyPublicRouteResponseMeta,
  buildPublicRouteDepsFromAstro,
  resolvePublicPageRoute,
} from "../core/public-routes.ts";
import FloatingWhatsApp from "../themes/default/components/FloatingWhatsApp.astro";
import Layout from "../themes/default/Layout.astro";
import SectionBranches from "../themes/default/sections/SectionBranches.astro";
import SectionRenderer from "../themes/default/sections/SectionRenderer.astro";
import PublicBreadcrumbs from "./layanan/_PublicBreadcrumbs.astro";
import PublicNotFoundView from "./layanan/_PublicNotFoundView.astro";

const deps = buildPublicRouteDepsFromAstro(
  Astro.locals,
  env as unknown as Record<string, unknown>,
);
const result = await resolvePublicPageRoute(Astro.request, deps, Astro.params.slug ?? "", {
  url: Astro.url,
});

if (result.kind === "response") {
  return result.response;
}

applyPublicRouteResponseMeta(Astro.response, result.http);
const enriched =
  result.kind === "page" ? await enrichPublicPageRouteResult(result, deps) : null;
---

{result.kind === "not_found" ? (
  <PublicNotFoundView result={result} />
) : (
  <Layout
    shell={result.shell}
    pageTitle={result.isHomepage ? undefined : result.pageTitle}
    pageDescription={result.seoMetadata.description || undefined}
    managedHead={true}
    layoutMode={result.layoutMode}
    currentPath={result.currentPath}
    initialCookieHeader={Astro.request.headers.get("cookie")}
    operatorKillSwitchActive={enriched?.operatorKillSwitchActive ?? false}
    pageType={result.isHomepage ? "home" : "page"}
    contentId={result.page ? result.page.slug : null}
  >
    <PublicSeoHead
      slot="head"
      metadata={enriched?.head.metadata ?? result.seoMetadata}
      schemaGraph={enriched?.head.schemaGraph ?? result.schemaGraph}
      seoAutopilotEnabled={enriched?.head.seoAutopilotEnabled ?? false}
      publishedVerificationTokens={enriched?.head.publishedVerificationTokens ?? null}
      blogEnabled={enriched?.head.blogEnabled ?? result.shell.site.blogEnabled}
      siteName={enriched?.head.siteName ?? result.shell.site.title}
      searchAppearance={enriched?.head.searchAppearance ?? null}
      templateValues={enriched?.head.templateValues}
    />

    {!result.isHomepage && result.layoutMode !== "focused" && result.breadcrumbs.length > 0 && (
      <div class="ps-page-breadcrumbs-bar">
        <div class="ps-container">
          <PublicBreadcrumbs items={result.breadcrumbs} />
        </div>
      </div>
    )}

    {result.page && result.page.sections.length > 0 ? (
      <SectionRenderer
        sections={result.page.sections}
        themeId={result.shell.themeId}
        routePath={result.currentPath}
        pageSlug={result.isHomepage ? null : result.page.slug}
        isHomepage={result.isHomepage}
        mode="published"
        businessCategory={result.shell.business.category}
        heroVariant={result.shell.themeStyle.variants.heroVariant}
        primaryOrigin={result.primaryOrigin}
        fallbackOfferings={result.fallbackOfferings}
        fallbackPosts={result.fallbackPosts}
        fallbackBranches={enriched?.activeBranches ?? []}
        fallbackForms={enriched?.publishedForms ?? {}}
        turnstileSiteKey={(env as unknown as { readonly TURNSTILE_SITE_KEY?: string }).TURNSTILE_SITE_KEY}
        businessName={result.shell.business.name}
        fallbackBusiness={{
          address: result.shell.business.address,
          city: result.shell.business.city,
          province: result.shell.business.province,
          postalCode: result.shell.business.postalCode,
          weekdayHours: result.shell.business.weekdayHours,
          holidayHours: result.shell.business.holidayHours,
          phone: result.shell.business.phone,
          whatsappE164: result.shell.business.whatsappE164,
          email: result.shell.business.email,
          mapsUrl: result.shell.business.mapsUrl,
        }}
      />
    ) : (
      <section class="ps-archive-section" data-testid="public-page-empty">
        <div class="ps-container">
          <div class="ps-state-panel">
            <h1 class="ps-state-heading">{result.pageTitle}</h1>
            <p class="ps-state-body">
              {result.shell.business.description ??
                result.shell.site.tagline ??
                "Informasi halaman akan ditampilkan di sini setelah konten diterbitkan."}
            </p>
            <div class="ps-actions">
              {result.shell.site.catalogEnabled && (
                <a href="/layanan" class="ps-btn ps-btn--primary">
                  Lihat Layanan
                </a>
              )}
              {result.shell.site.blogEnabled && (
                <a href="/blog" class="ps-btn ps-btn--secondary">
                  Baca Blog
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    {enriched?.shouldRenderStandaloneBranches && (
      <SectionBranches
        id="lokasi-cabang"
        businessName={result.shell.business.name}
        headOffice={{
          name: result.shell.business.name,
          address: result.shell.business.address,
          city: result.shell.business.city,
          province: result.shell.business.province,
          postalCode: result.shell.business.postalCode,
          phone: result.shell.business.phone,
          whatsappE164: result.shell.business.whatsappE164,
          mapsUrl: result.shell.business.mapsUrl,
          weekdayHours: result.shell.business.weekdayHours,
          holidayHours: result.shell.business.holidayHours,
        }}
        branches={enriched.activeBranches}
        surfaceTone="muted"
      />
    )}

    {result.floatingWa.phone && (
      <FloatingWhatsApp
        slot="floating"
        shell={result.shell}
        phone={result.floatingWa.phone}
        businessName={result.floatingWa.businessName}
        greetingMessage={result.floatingWa.greetingMessage}
        operatingHours={result.floatingWa.operatingHours}
        holidayHours={result.floatingWa.holidayHours}
        primaryOrigin={result.floatingWa.primaryOrigin}
        canonicalPath={result.floatingWa.canonicalPath}
        itemTitle={result.floatingWa.itemTitle}
      />
    )}
  </Layout>
)}
