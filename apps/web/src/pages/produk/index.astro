---
import { env } from "cloudflare:workers";
import { enrichPublicOfferingListingResult } from "../../components/seo/public-seo-context.ts";
import {
  applyPublicRouteResponseMeta,
  buildPublicRouteDepsFromAstro,
  resolveOfferingListingRoute,
} from "../../core/public-routes.ts";
import OfferingListingView from "../layanan/_OfferingListingView.astro";
import PublicNotFoundView from "../layanan/_PublicNotFoundView.astro";

const deps = buildPublicRouteDepsFromAstro(
  Astro.locals,
  env as unknown as Record<string, unknown>,
);
const result = await resolveOfferingListingRoute(Astro.request, deps, "product", {
  url: Astro.url,
});

if (result.kind === "response") {
  return result.response;
}

applyPublicRouteResponseMeta(Astro.response, result.http);
const enriched =
  result.kind === "offering_listing"
    ? await enrichPublicOfferingListingResult(result, deps)
    : null;
---

{result.kind === "not_found" ? (
  <PublicNotFoundView result={result} />
) : (
  <OfferingListingView result={result} headProps={enriched?.head ?? null} />
)}
