---
import { env } from "cloudflare:workers";
import { getSessionSecondFactorState } from "@punyasitus/auth";
import { getActivePlatformOperator } from "@punyasitus/db/platform";
import "../../../styles/admin/globals.css";
import { TwoFactorFlow, type InitialTwoFactorStatus } from "./_TwoFactorFlow";

function sanitizeNextPath(raw: string | null): string {
  if (!raw) return "/account/security";
  const trimmed = raw.trim();
  if (!trimmed.startsWith("/") || trimmed.startsWith("//") || trimmed.includes("\\")) {
    return "/account/security";
  }
  if (
    trimmed === "/account" ||
    trimmed.startsWith("/account/") ||
    trimmed.startsWith("/dashboard/") ||
    trimmed === "/console" ||
    trimmed.startsWith("/console/") ||
    trimmed === "/"
  ) {
    return trimmed;
  }
  return "/account/security";
}

const authUser = Astro.locals.authUser;
const authSession = Astro.locals.authSession;
const cookieHeader = Astro.request.headers.get("cookie") ?? "";
const pendingChallenge =
  !authUser &&
  cookieHeader
    .split(";")
    .map((p) => p.trim())
    .some((p) => (p.split("=")[0]?.trim() ?? "").endsWith(".two_factor"));

let enrolled = false;
let isPlatformOperator = false;
let sessionVerified = false;
let verifiedAtMs: number | null = null;

if (authUser && authSession && env.PLATFORM_DB) {
  try {
    const [op, tfState] = await Promise.all([
      getActivePlatformOperator(env.PLATFORM_DB, authUser.id),
      getSessionSecondFactorState(env.PLATFORM_DB, {
        sessionId: authSession.id,
        userId: authUser.id,
      }),
    ]);
    isPlatformOperator = op !== null;
    enrolled = tfState.twoFactorEnabled;
    sessionVerified = tfState.sessionVerified;
    verifiedAtMs = tfState.verifiedAtMs;
  } catch {
    // Keep conservative defaults if DB read fails
  }
}

const rawMode = Astro.url.searchParams.get("mode");
const initialMode: "enroll" | "verify" =
  rawMode === "enroll"
    ? "enroll"
    : rawMode === "verify" || pendingChallenge || enrolled
      ? "verify"
      : "enroll";

const nextPath = sanitizeNextPath(Astro.url.searchParams.get("next"));

const initialStatus: InitialTwoFactorStatus = {
  authenticated: Boolean(authUser && authSession),
  pendingChallenge,
  enrolled,
  isPlatformOperator,
  sessionVerified,
  verifiedAtMs,
  userEmail: authUser?.email ?? null,
};

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23176b51'/%3E%3Ctext x='16' y='21' text-anchor='middle' font-family='sans-serif' font-size='14' font-weight='700' fill='%23ffffff'%3EPS%3C/text%3E%3C/svg%3E"
    />
    <title>Autentikasi Dua Faktor (2FA) — PunyaSitus</title>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground"
    >
      Lewati ke konten utama
    </a>

    <header class="border-b border-border bg-card">
      <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
        <a
          href="/account/security"
          class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-foreground md:min-h-0"
        >
          <span
            class="inline-flex size-7 items-center justify-center rounded-md bg-primary text-xs font-bold text-primary-foreground"
            aria-hidden="true"
          >
            PS
          </span>
          <span>PunyaSitus</span>
        </a>
        <span class="text-xs text-muted-foreground">Keamanan 2FA</span>
      </div>
    </header>

    <main
      id="main-content"
      class="mx-auto flex min-h-[calc(100vh-3.5rem)] w-full max-w-5xl items-center justify-center px-4 py-8"
    >
      <TwoFactorFlow
        client:load
        initialStatus={initialStatus}
        initialMode={initialMode}
        nextPath={nextPath}
      />
    </main>
  </body>
</html>
