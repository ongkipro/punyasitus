---
import { getTenantPluginStoreSnapshot } from "@punyasitus/db/plugins/store/index";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { PluginStoreClient } from "./_PluginStoreClient";
import { resolvePluginAdminServerContext } from "./_server-context";

const resolved = await resolvePluginAdminServerContext(Astro);
if (!resolved.ok) {
  return resolved.response;
}
const ctx = resolved.ctx;

const snapshot = await getTenantPluginStoreSnapshot(ctx.platformDb, {
  tenantId: ctx.tenantId,
});
---

<DashboardLayout
  title={`Toko Plugin — ${ctx.workspaceName}`}
  surface="dashboard"
  workspaceName={ctx.workspaceName}
  workspaceSubtitle={ctx.workspaceSubtitle}
  activeNavId="plugins"
  basePath={ctx.basePath}
  offeringLabel={ctx.offeringLabel}
  lifecycleStatus={ctx.lifecycleStatus}
  lifecycleDaysRemaining={ctx.lifecycleDaysRemaining}
  lifecycleReason={ctx.lifecycleReason}
  publicSiteHref={ctx.publicSiteHref}
  userDisplayName={ctx.userDisplayName}
  userRoleLabel={ctx.permissions.roleLabel}
>
  <PluginStoreClient
    client:load
    handle={ctx.handle}
    basePath={ctx.basePath}
    apiBaseUrl={`/api/tenants/${encodeURIComponent(ctx.handle)}/plugins`}
    billingPayer={snapshot.billingPayer}
    initialItems={snapshot.items}
    initialOrders={snapshot.orders}
    initialReceipts={snapshot.receipts}
    initialCustomDevRequests={snapshot.customDevRequests}
    initialQuota={snapshot.customDevQuota}
    permissions={{
      role: ctx.permissions.role,
      roleLabel: ctx.permissions.roleLabel,
      isLocked: ctx.permissions.isLocked,
      canManagePlugins: ctx.permissions.canManagePlugins,
    }}
  />
</DashboardLayout>
