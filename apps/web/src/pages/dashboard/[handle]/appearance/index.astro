---
import { env } from "cloudflare:workers";
import type { TenantStoreNamespaceLike } from "@punyasitus/db/connections";
import type { TenantStatus, TenantVertical } from "@punyasitus/db/platform";
import type { LifecycleStatus } from "@/components/admin/navigation";
import { renderPreviewDocumentInProcess } from "@/core/preview/astro-renderer";
import { renderTenantDraftPreview } from "@/core/preview/service";
import { bindTenantDatabase } from "@/core/tenant";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import {
  buildHomepageSnapshotFromSections,
  loadThemeCustomizerAdminState,
} from "../../../api/tenants/[tenantId]/theme/_shared";
import { ThemeCustomizer } from "./_ThemeCustomizer";

const HANDLE_RE = /^[a-z0-9](?:[a-z0-9-]{1,38}[a-z0-9])?$/;

function neutralNotFoundResponse(): Response {
  return new Response(
    `<!doctype html><html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>Halaman tidak ditemukan</title></head><body><main><h1>Halaman tidak ditemukan</h1></main></body></html>`,
    {
      status: 404,
      headers: {
        "Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "private, no-store",
        "X-Robots-Tag": "noindex, nofollow",
      },
    },
  );
}

function mapTenantStatusToLifecycle(status: TenantStatus): LifecycleStatus {
  if (
    status === "trial" ||
    status === "active" ||
    status === "grace" ||
    status === "locked" ||
    status === "suspended"
  ) {
    return status;
  }
  return "suspended";
}

function mapVerticalToOfferingLabel(vertical?: TenantVertical): string {
  switch (vertical) {
    case "catalog":
    case "resto":
      return "Produk";
    case "travel":
      return "Paket Tur";
    case "dealer":
      return "Kendaraan";
    default:
      return "Layanan";
  }
}

const rawHandle = (Astro.params.handle ?? "").trim().toLowerCase();
const isLocalEnv = env.APP_ENV === "local";
const isLocalLoopback = Astro.locals.isLocalLoopback && isLocalEnv;

// Strict platform app-host isolation: NEVER served on tenant or console hosts!
if (!HANDLE_RE.test(rawHandle) || (!isLocalLoopback && Astro.locals.surface !== "app")) {
  return neutralNotFoundResponse();
}

const authorizedMember = Astro.locals.authorizedTenantMember;
const authUser = Astro.locals.authUser;
if (!authorizedMember && !isLocalLoopback) {
  return neutralNotFoundResponse();
}

const tenantId = authorizedMember?.tenantId ?? Astro.locals.tenant?.id ?? "";
const workspaceName = authorizedMember?.tenantName ?? Astro.locals.tenant?.name ?? rawHandle;
const saasZone = env.SAAS_ZONE || "situsku.click";
const workspaceSubtitle = Astro.locals.tenant?.primaryHost ?? `${rawHandle}.${saasZone}`;
const basePath = `/dashboard/${rawHandle}`;
const offeringLabel = mapVerticalToOfferingLabel(Astro.locals.tenant?.vertical);
const tenantStatus: TenantStatus =
  authorizedMember?.tenantStatus ?? Astro.locals.tenant?.status ?? "active";
const lifecycleStatus = mapTenantStatusToLifecycle(tenantStatus);

const tenantDb =
  Astro.locals.tenantDb ??
  (tenantId
    ? bindTenantDatabase(env.TENANT_STORE as unknown as TenantStoreNamespaceLike, tenantId)
    : null);

if (!tenantDb || !tenantId) {
  return new Response("Penyimpanan data tenant sementara tidak tersedia.", {
    status: 503,
    headers: {
      "Content-Type": "text/plain; charset=utf-8",
      "Cache-Control": "private, no-store",
      "X-Robots-Tag": "noindex, nofollow",
    },
  });
}

const initialState = await loadThemeCustomizerAdminState(tenantDb, {
  tenantId,
  tenantName: workspaceName,
  userId: authUser?.id ?? "local-dev",
  role: authorizedMember?.role ?? "owner",
  tenantStatus,
});

// Pre-render the live draft preview HTML directly in-process via Layout.astro
let initialPreviewHtml: string | null;
try {
  const rendered = await renderTenantDraftPreview(
    {
      platformDb: env.PLATFORM_DB,
      tenantDb,
      tenantId,
      tenantHandle: rawHandle,
      tenantName: workspaceName,
      input: {
        resourceKind: "home",
        themeId: initialState.themeId,
        draftOverride: {
          themeConfig: {
            themeId: initialState.themeId,
            tokens: initialState.draft.tokens,
            variants: initialState.draft.variants,
          },
          page: buildHomepageSnapshotFromSections(initialState.draft.sections, {
            slug: initialState.homepageSlug,
            title: initialState.homepageTitle,
          }),
        },
      },
    },
    renderPreviewDocumentInProcess,
  );
  initialPreviewHtml = rendered.html;
} catch {
  initialPreviewHtml = null;
}

const userRoleLabel =
  authorizedMember?.role === "owner"
    ? "Pemilik Situs"
    : authorizedMember?.role === "admin"
      ? "Admin"
      : authorizedMember?.role === "editor"
        ? "Editor"
        : "Pemilik Situs";

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<DashboardLayout
  title={`Sesuaikan Tema — ${workspaceName}`}
  surface="dashboard"
  workspaceName={workspaceName}
  workspaceSubtitle={workspaceSubtitle}
  activeNavId="theme"
  basePath={basePath}
  offeringLabel={offeringLabel}
  lifecycleStatus={lifecycleStatus}
  publicSiteHref={`https://${workspaceSubtitle}`}
  userDisplayName={authUser?.name ?? "Admin Situs"}
  userRoleLabel={userRoleLabel}
>
  <ThemeCustomizer
    client:load
    tenantHandle={rawHandle}
    workspaceName={workspaceName}
    themeApiUrl={`/api/tenants/${encodeURIComponent(rawHandle)}/theme`}
    publishApiUrl={`/api/tenants/${encodeURIComponent(rawHandle)}/theme/publish`}
    previewApiUrl={`/api/tenants/${encodeURIComponent(rawHandle)}/preview`}
    initialState={initialState}
    initialPreviewHtml={initialPreviewHtml}
  />
</DashboardLayout>
