---
import { env } from "cloudflare:workers";
import type { Role } from "@punyasitus/core/schemas";
import type { TenantStoreNamespaceLike } from "@punyasitus/db/connections";
import type { TenantStatus, TenantVertical } from "@punyasitus/db/platform";
import type { LifecycleStatus } from "@/components/admin/navigation";
import { bindTenantDatabase } from "@/core/tenant";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import {
  createNeutralPresetNotFoundHtmlResponse,
  loadVerticalOnboardingPageOrGateResponse,
} from "./_page-gate";
import { StarterPresetWizard } from "./_StarterPresetWizard";

const HANDLE_RE = /^[a-z0-9](?:[a-z0-9-]{1,38}[a-z0-9])?$/;

function mapTenantStatusToLifecycle(status: TenantStatus): LifecycleStatus {
  if (
    status === "trial" ||
    status === "active" ||
    status === "grace" ||
    status === "locked" ||
    status === "suspended"
  ) {
    return status;
  }
  return "suspended";
}

function mapVerticalToOfferingLabel(vertical?: TenantVertical): string {
  switch (vertical) {
    case "catalog":
    case "resto":
      return "Produk";
    case "travel":
      return "Paket Tur";
    case "dealer":
      return "Kendaraan";
    default:
      return "Layanan";
  }
}

const rawHandle = (Astro.params.handle ?? "").trim().toLowerCase();
const isLocalEnv = env.APP_ENV === "local";
const isLocalLoopback = Astro.locals.isLocalLoopback && isLocalEnv;

// Strict platform app-host isolation: NEVER served on tenant or console hosts!
if (!HANDLE_RE.test(rawHandle) || (!isLocalLoopback && Astro.locals.surface !== "app")) {
  return createNeutralPresetNotFoundHtmlResponse();
}

const authorizedMember = Astro.locals.authorizedTenantMember;
const authUser = Astro.locals.authUser;
if (!authorizedMember && !isLocalLoopback) {
  return createNeutralPresetNotFoundHtmlResponse();
}

// Fail closed when authorized member's canonical handle disagrees with URL param
if (authorizedMember && authorizedMember.handle.toLowerCase() !== rawHandle) {
  return createNeutralPresetNotFoundHtmlResponse();
}

const canonicalHandle = authorizedMember?.handle ?? rawHandle;
const tenantId = authorizedMember?.tenantId ?? Astro.locals.tenant?.id ?? "";
const workspaceName = authorizedMember?.tenantName ?? Astro.locals.tenant?.name ?? canonicalHandle;
const saasZone = env.SAAS_ZONE || "situsku.click";
const workspaceSubtitle = Astro.locals.tenant?.primaryHost ?? `${canonicalHandle}.${saasZone}`;
const basePath = `/dashboard/${canonicalHandle}`;
const offeringLabel = mapVerticalToOfferingLabel(Astro.locals.tenant?.vertical);
const tenantStatus: TenantStatus =
  authorizedMember?.tenantStatus ?? Astro.locals.tenant?.status ?? "active";
const role: Role = authorizedMember?.role ?? "owner";
const lifecycleStatus = mapTenantStatusToLifecycle(tenantStatus);

// Verify `operator_hold` fail-closed from PLATFORM_DB BEFORE opening TenantStore
let operatorHold = false;
if (authorizedMember && tenantId) {
  if (!env.PLATFORM_DB) {
    return new Response("Layanan basis data platform sementara tidak tersedia.", {
      status: 503,
      headers: {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "private, no-store",
        "X-Robots-Tag": "noindex, nofollow",
      },
    });
  }
  try {
    const holdRow = await env.PLATFORM_DB.prepare(
      "SELECT operator_hold FROM tenants WHERE id = ? LIMIT 1",
    )
      .bind(tenantId)
      .first<{ readonly operator_hold: number | null }>();
    operatorHold = Number(holdRow?.operator_hold ?? 0) === 1;
  } catch {
    return new Response("Gagal memverifikasi status situs.", {
      status: 503,
      headers: {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "private, no-store",
        "X-Robots-Tag": "noindex, nofollow",
      },
    });
  }
}

// Enforce lifecycle, operatorHold & RBAC gate STRICTLY BEFORE binding TenantStore or reading tenant data!
const loaded = await loadVerticalOnboardingPageOrGateResponse({
  platformDb: env.PLATFORM_DB,
  operatorHold,
  member: {
    tenantId,
    handle: canonicalHandle,
    tenantName: workspaceName,
    userId: authUser?.id ?? "local-dev",
    role,
    tenantStatus,
  },
  resolveTenantDb: () =>
    Astro.locals.tenantDb ??
    (tenantId
      ? bindTenantDatabase(env.TENANT_STORE as unknown as TenantStoreNamespaceLike, tenantId)
      : null),
});

if (!loaded.ok) {
  return loaded.response;
}

const initialState = loaded.initialState;
const verticalState = loaded.verticalState;
const userRoleLabel =
  role === "owner"
    ? "Pemilik Situs"
    : role === "admin"
      ? "Admin"
      : role === "editor"
        ? "Editor"
        : "Pemilik Situs";

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<DashboardLayout
  title={`Onboarding Preset Pemula — ${workspaceName}`}
  surface="dashboard"
  workspaceName={workspaceName}
  workspaceSubtitle={workspaceSubtitle}
  activeNavId="home"
  basePath={basePath}
  offeringLabel={offeringLabel}
  lifecycleStatus={lifecycleStatus}
  publicSiteHref={`https://${workspaceSubtitle}`}
  userDisplayName={authUser?.name ?? "Admin Situs"}
  userRoleLabel={userRoleLabel}
>
  <StarterPresetWizard
    client:load
    tenantHandle={canonicalHandle}
    workspaceName={workspaceName}
    surfaceMode="onboarding"
    presetsApiUrl={`/api/tenants/${encodeURIComponent(canonicalHandle)}/presets`}
    applyApiUrl={`/api/tenants/${encodeURIComponent(canonicalHandle)}/presets/apply`}
    draftApiUrl={`/api/tenants/${encodeURIComponent(canonicalHandle)}/presets/draft`}
    previewApiUrl={`/api/tenants/${encodeURIComponent(canonicalHandle)}/presets/preview`}
    publishApiUrl={`/api/tenants/${encodeURIComponent(canonicalHandle)}/presets/publish`}
    verticalPresetsApiUrl={`${basePath}/onboarding/api`}
    customizerHref={`${basePath}/appearance`}
    pagesHref={`${basePath}/pages`}
    initialState={initialState}
    initialVerticalState={verticalState}
  />
</DashboardLayout>
