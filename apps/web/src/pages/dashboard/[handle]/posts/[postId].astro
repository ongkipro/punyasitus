---
import { getPostById, listBlogTaxonomies, listPostAuthors } from "@punyasitus/db/posts/index";
import { isSeoAutopilotEnabledForTenant } from "@punyasitus/db/seo/index";
import {
  neutralAdminNotFoundResponse,
  resolveCmsAdminServerContext,
} from "@/components/admin/editor/cms-server-context";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { PostEditorClient } from "./_PostEditorClient";

const resolved = await resolveCmsAdminServerContext(Astro);
if (!resolved.ok) {
  return resolved.response;
}

const rawId = (Astro.params.postId ?? "").trim();
if (!/^[1-9]\d{0,9}$/.test(rawId)) {
  return neutralAdminNotFoundResponse();
}

const { ctx } = resolved;
const [post, catsRes, tagsRes, authorsRes, seoAutopilotEnabled] = await Promise.all([
  getPostById(ctx.tenantDb, Number(rawId), { includeTrashed: true }),
  listBlogTaxonomies(ctx.tenantDb, { kind: "post_category", limit: 100, sortOrder: "asc" }),
  listBlogTaxonomies(ctx.tenantDb, { kind: "post_tag", limit: 100 }),
  listPostAuthors(ctx.tenantDb, { tenantId: ctx.tenantId, limit: 100 }),
  isSeoAutopilotEnabledForTenant(ctx.tenantDb),
]);

if (!post) {
  return neutralAdminNotFoundResponse();
}
---

<DashboardLayout
  title={`Edit ${post.title} — ${ctx.workspaceName}`}
  surface="dashboard"
  workspaceName={ctx.workspaceName}
  workspaceSubtitle={ctx.workspaceSubtitle}
  activeNavId="articles"
  basePath={ctx.basePath}
  offeringLabel={ctx.offeringLabel}
  lifecycleStatus={ctx.lifecycleStatus}
  lifecycleDaysRemaining={ctx.lifecycleDaysRemaining}
  lifecycleReason={ctx.lifecycleReason}
  publicSiteHref={ctx.publicSiteHref}
  userDisplayName={ctx.userDisplayName}
  userRoleLabel={ctx.permissions.roleLabel}
>
  <PostEditorClient
    client:only="react"
    handle={ctx.handle}
    basePath={ctx.basePath}
    permissions={ctx.permissions}
    siteName={ctx.workspaceName}
    primaryHost={ctx.workspaceSubtitle}
    seoAutopilotEnabled={seoAutopilotEnabled}
    initialPost={{
      id: post.id,
      title: post.title,
      slug: post.slug,
      excerpt: post.excerpt ?? "",
      body: post.body,
      status: post.status,
      featuredMediaId: post.featuredMediaId,
      authorId: post.authorId,
      primaryCategoryId: post.primaryCategoryId,
      categoryIds: post.categoryIds,
      tagIds: post.tagIds,
      enableToc: post.enableToc,
      seo: post.seo ?? null,
      hasUnpublishedChanges: post.hasUnpublishedChanges,
      publishedAt: post.publishedAt,
      contentModifiedAt: post.contentModifiedAt,
      version: post.version,
    }}
    categories={catsRes.items.map((c) => ({
      id: c.id,
      name: c.name,
      slug: c.slug,
      depth: c.depth,
      parentId: c.parentId,
    }))}
    tags={tagsRes.items.map((t) => ({ id: t.id, name: t.name, slug: t.slug }))}
    authors={authorsRes.map((a) => ({
      id: a.id,
      name: a.name,
      roleTitle: a.roleTitle,
      bio: a.bio,
    }))}
  />
</DashboardLayout>
