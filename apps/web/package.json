{
  "name": "@punyasitus/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:wrangler": "wrangler dev --local --ip 127.0.0.1 --persist-to .wrangler/state",
    "build": "astro build",
    "typecheck": "astro sync && astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/react": "7.1.9",
    "@base-ui/react": "1.9.0",
    "@punyasitus/auth": "workspace:*",
    "@punyasitus/core": "workspace:*",
    "@punyasitus/db": "workspace:*",
    "@punyasitus/integrations": "workspace:*",
    "@punyasitus/plugins": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.166.0"
  }
}
