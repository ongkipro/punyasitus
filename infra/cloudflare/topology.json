{
  "schemaVersion": "1.0",
  "project": "punyasitus",
  "contractOwners": [
    "PRD.md#REQ-041",
    "PRD.md#REQ-095",
    "PLAN.md#section-2",
    "PLAN.md#section-3",
    "PLAN.md#section-12",
    "docs/adr/ADR-0009-cloudflare-native-multi-tenant-runtime.md"
  ],
  "resourcePrefix": "punyasitus-",
  "forbiddenResourcePrefixes": ["adsbook-"],
  "worker": {
    "name": "punyasitus-web",
    "workers_dev": false,
    "preview_urls": false,
    "limits": {
      "cpu_ms": 50
    },
    "dcvPassThroughPaths": [
      "/.well-known/pki-validation/*",
      "/.well-known/acme-challenge/*"
    ],
    "dcvExcludedPaths": [
      "/.well-known/cf-custom-hostname-challenge/*"
    ],
    "unknownHostPolicy": {
      "status": 404,
      "cacheControl": "no-store",
      "xRobotsTag": "noindex, nofollow",
      "csp": "default-src 'none'",
      "apiJsonError": {
        "success": false,
        "code": "NOT_FOUND"
      }
    }
  },
  "enterpriseOnlyFeatures": {
    "wildcard_custom_hostnames": false,
    "custom_metadata": false,
    "apex_proxying": false
  },
  "environments": {
    "production": {
      "workerName": "punyasitus-web",
      "appEnv": "production",
      "platformZone": {
        "zone": "punyasitus.com",
        "cloudflareForSaas": false,
        "customDomains": [
          {
            "hostname": "punyasitus.com",
            "surface": "marketing",
            "worker": "punyasitus-web"
          },
          {
            "hostname": "www.punyasitus.com",
            "surface": "marketing",
            "worker": "punyasitus-web",
            "redirect": {
              "status": 308,
              "target": "https://punyasitus.com"
            }
          },
          {
            "hostname": "app.punyasitus.com",
            "surface": "app",
            "worker": "punyasitus-web"
          },
          {
            "hostname": "console.punyasitus.com",
            "surface": "console",
            "worker": "punyasitus-web"
          }
        ],
        "emailSubdomain": "notif.punyasitus.com",
        "zoneSettings": {
          "ssl_mode": "strict",
          "always_use_https": true,
          "min_tls_version": "1.2",
          "bot_fight_mode": false
        },
        "waf": {
          "planTier": "free",
          "maxCustomRulesPerZone": 5,
          "maxRateLimitRulesPerZone": 1,
          "customRules": [
            {
              "id": "ps-prod-platform-block-sensitive-probes",
              "description": "Block probes for dotfiles and legacy PHP admin endpoints on platform hosts",
              "expression": "(http.request.uri.path matches \"^/(\\\\.env|\\\\.git|wp-login\\\\.php|xmlrpc\\\\.php)\")",
              "action": "block"
            },
            {
              "id": "ps-prod-platform-console-method-guard",
              "description": "Block unexpected HTTP methods on console.punyasitus.com",
              "expression": "(http.host eq \"console.punyasitus.com\" and not http.request.method in {\"GET\" \"HEAD\" \"POST\" \"PUT\" \"PATCH\" \"DELETE\" \"OPTIONS\"})",
              "action": "block"
            }
          ],
          "rateLimitRules": [
            {
              "id": "ps-prod-platform-auth-ratelimit",
              "description": "Edge burst cap for auth endpoints on app.punyasitus.com (complements D1 atomic limits)",
              "expression": "(http.host eq \"app.punyasitus.com\" and starts_with(http.request.uri.path, \"/api/auth/\"))",
              "characteristics": ["ip.src"],
              "requestsPerPeriod": 60,
              "periodSeconds": 10,
              "mitigationTimeoutSeconds": 10,
              "action": "block"
            }
          ]
        }
      },
      "saasZone": {
        "zone": "situsku.click",
        "cloudflareForSaas": true,
        "fallbackOrigin": "fallback.situsku.click",
        "cnameTarget": "cname.situsku.click",
